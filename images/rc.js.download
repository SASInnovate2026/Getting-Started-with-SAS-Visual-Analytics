function markQues(quesnum) {
	myCorrect = "<img src='../rc_common/qcorrect.png' width='17' height='40' border='0' alt='Correct'>";
	myWrong = "<img src='../rc_common/qwrong.png' width='17' height='40' border='0' alt='Incorrect'>";
   	// Captivate cs or quiz 
   	if (opener.user_array) {
	  // if answer is C for correct 
      	if (opener.answer_array[quesnum]=="C") { 
         	document.write(myCorrect);
      	}
		// else if answer is W for Way Wrong, Dude 
      	else {
         	document.write(myWrong);
      	}
   	}
    else if (myCourseType=="practiceExam") {
      	if (ans[quesnum-1] == correctAns[quesnum-1]) { 
         	document.write(myCorrect);
      	}
      	else {
         	document.write(myWrong);
      	}
   	}
  	// SPEL-style case study or quiz 
   	else if (window.opener.opener) {
      	if (ans[quesnum-1] == correctAns[quesnum-1]) { 
         	document.write(myCorrect);
      	}
      	else {
         	document.write(myWrong);
      	}
   	}
   	// for marking Captivate case study or quiz passed with no answers entered 
   	else return;
}


function writeYanswerCanswer(quesnum) { 
     // Captivate case study or quiz 
	if (opener.user_array) {
		document.write('<strong>Your answer: ' + opener.user_array[quesnum] +'<br>Correct answer: ' + opener.correct_array[quesnum] +'</strong><br><br>');	
	}
	else if (myCourseType=="practiceExam") { 
		document.write('<strong>Your answer: <font color="#003399">' + ans[quesnum-1] +'</font><br>Correct answer: <font color="#003399">' + correctAns[quesnum-1] +'</font></strong><br><br>');
	}
	else if (window.opener.opener) { 
		// for SPEL-style case study or quiz 
		document.write('<strong>' +yanswer+': <font color="#003399">' + ans[quesnum-1] +'</font><br>' +canswer+': <font color="#003399">' + correctAns[quesnum-1] +'</font></strong><br><br>');
	}
		// for marking Captivate case study or quiz passed with no answers entered 
	else return;
}


function openWideResults(docname) {   
	newWindow = window.open(docname,'Results','top=0,left=0,width=725,height=650,resizable=yes,scrollbars=yes');
	if (alreadyopen) {
		alreadyopen = false
	}
	alreadyopen = true
	if (newWindow != null) {
		if (newWindow.opener == null) {
			newWindow.opener = self;
		}
	}
}


function writeQuizScore() {
	document.write(myScore + "%");
}


function writeQuizFeedback() {
	if (window.opener.opener){
		myQuizPage = window;
	}
	else {
		myQuizPage = window.opener;
	}
		
	if (quizPlace == "finalcase"){
		if (myQuizPage.myScore >= passingScore) {
			if (window.opener.opener.VLEcourse || window.opener.opener.SCORMcourse) quizFeedback = passquiz;
			else quizFeedback = passquizfinal;
		} 
		else {
			quizFeedback = failcase;
		}
	}

	else {
		if (myQuizPage.myScore >= passingScore) { 
			quizFeedback = passquiz;
		} 
		else {
			quizFeedback = failquiz;
		}
	}
	document.write(quizFeedback);
}


function markAllQuizzesComplete(){

	for(i=0;i<lessonTitles.length;i++){
			var mynum = lessonTitles[i][0].slice(-2);
			window.opener.eCourseX.reqLessonsComplete[mynum] =  "yes";
			var mylessKeys = Object.keys(window.opener.eCourseX.lessReport);
				for(a=0;a<mylessKeys.length;a++){
					if(window.opener.eCourseX.lessReport[a]['complete']==0 || window.opener.eCourseX.lessReport[a]['complete']==null){
						window.opener.eCourseX.lessReport[a]['complete'] = Date.now();
						window.opener.eCourseX.lessReport[a]['debug'] = Date.now();
						if(window.opener.eCourseX.lessReport[a]['start']==0 || window.opener.eCourseX.lessReport[a]['start']==null)window.opener.eCourseX.lessReport[a]['start']==Date.now();
						
					}

				}
			if(!window.opener.eCourseX.lessonComplete.includes(mynum))	window.opener.eCourseX.lessonComplete.push(mynum);
			window.opener.setLRSdata();
			window.opener.setChecks();
		
	}
	eCourseX.cprog = 100;
	eCourseX.coursecomplete = Date.now();
	eCourseX.movieComplete = [];
	if(confirm("Record Completion in Totara?")==true){
		window.opener.parent.SetReachedEnd();
		window.opener.parent.SetScore(100,100,0);
		window.opener.parent.SetPassed();
		window.opener.parent.CommitData();
	}
}


function markReqLessonsComplete(){
	if(reqLessons.length >0) {
		for(i=0;i<reqLessons.length;i++){
			window.opener.eCourseX.reqLessonsComplete[reqLessons[i]] =  "yes";
				if(!window.opener.eCourseX.lessonComplete.includes(reqLessons[i])) window.opener.eCourseX.lessonComplete.push(reqLessons[i]);
				window.opener.setLRSdata();
				window.opener.setChecks();
		}
	}
	else{
		for(i=0;i<lessonTitles.length;i++){
			//If it's not a Resources lesson, and if it's not listed as "Optional" in the title, include it
			var nokeyword = true;
			if(!optlesstitles.includes(lessonTitles[i][0])){
				
				for(j=0;j<optkeywords.length;j++){
					if(lessonTitles[i][1].indexOf(optkeywords[j])>-1) nokeyword = false;
				}
			}
			else nokeyword = false;
			if(nokeyword ){
				var mynum = lessonTitles[i][0].slice(-2);
				window.opener.eCourseX.reqLessonsComplete[mynum] =  "yes";
				var mylessKeys = Object.keys(window.opener.eCourseX.lessReport);
				for(a=0;a<mylessKeys.length;a++){
					if(window.opener.eCourseX.lessReport[a]['complete']==0 || window.opener.eCourseX.lessReport[a]['complete']==null){
						window.opener.eCourseX.lessReport[a]['complete'] = Date.now();
						window.opener.eCourseX.lessReport[a]['debug'] = Date.now();
						if(window.opener.eCourseX.lessReport[a]['start']==0 || window.opener.eCourseX.lessReport[a]['start']==null)window.opener.eCourseX.lessReport[a]['start']==Date.now();
						
					}

				}
				if(!window.opener.eCourseX.lessonComplete.includes(mynum))	window.opener.eCourseX.lessonComplete.push(mynum);
				window.opener.eCourseX.coursecomplete = Date.now();
				window.opener.setLRSdata();
				window.opener.setChecks();
			}

		}
	}	
	eCourseX.cprog = 100;
	eCourseX.coursecomplete = Date.now();
	eCourseX.movieComplete = [];
	if(confirm("Record Completion in Totara?")==true){
		window.opener.parent.SetReachedEnd();
		window.opener.parent.SetScore(100,100,0);
		window.opener.parent.SetPassed();
		window.opener.parent.CommitData();
	}
}

//actually marks lesson complete, not just quiz, despite function name
