function continueMovie(direction) { 
	//console.log("in continuemovie and direction is " + direction);
	//console.log("myobjectid is " + myObjectID + " and SCOlast is " + SCOlast);
	//if (myObjectID.indexOf("fade") == -1) { 
	
	$.each(gMovieArray, function (i, v) {
			//v is the array for each movie, from rc_course.
		if (myorigmov == v[0]) {
			//if the call came from the back button, decrease i, otherwise, increase
			mynum = (direction == "back") ? i - 1 : i + 1;
			//if direction parameter (movie, not back) is specified, go to that movie
			if ((direction) && (mynum == i + 1)) {
				if(SCORMcourse){
					if(myorigmov == SCOlast){
						alert(endlesson);
					} 
					else {
						showMovieDivCheck(direction);
						return false;
					}
				}
				else{
					showMovieDivCheck(direction);
					return false;
				}
			}
			// else if not first movie in the course, display movie
			else if (mynum > -1 && mynum < gMovieArray.length) {
					// do not mark quiz complete only by using Next or Back button
					//&& 
			//	if (((v[2].indexOf('Quiz') == -1) && (v[2]!="Case Study") && (direction != "back"))) {
				//	console.log("calling markMovieComplete from 647 for " + myObjectID);
			//		markMovieComplete(myObjectID);
			//	}
			
				
				myTOCTopic = gMovieArray[mynum][2]; 
				//myFinalMovie = gMovieArray[gMovieArray.length -2][0];
				/*if (gMovieArray[mynum][0] == myFinalMovie && (direction != "back")){
				//alert("You've reached the end of this course.");
					markMovieComplete(myFinalMovie);
				}*/

				$('#notifier').text(myTOCTopic);
				
				//This is needed to ensure that navigation can't go from one SCO to the next in a true SCORM setting
				if(SCORMcourse){
					if(myorigmov == SCOlast && !direction){
						alert(endlesson);
					} 
					else if(myorigmov == SCOfirst && direction=="back"){
						alert(navbeg);
					}
					else {
						showMovieDivCheck(gMovieArray[mynum][0]);
						return false;
					}
				}
				//if it's not true SCORM, navigation can just go from one lesson to the next (or previous) without issue
				else{
					showMovieDivCheck(gMovieArray[mynum][0]);
					return false;
				}
			}
			// else if first movie, display a message
			else if (mynum == -1) {
				alert(navbeg);
			}
		}
	});
}



/*!
 * checkResume()
 *
 * use the JSON object to check which intro to play
 *
 */
function checkResume() {
	//This is all needed to make resume work correctly both in a true scorm setting and in a vle/totara setting
	if(SCORMcourse){
		if (eCourseX.resume) {
			//i think this needs to use currentMovie instead of bookmark, because bookmark could be in the wrong SCO.
			$.each(eCourseX.currentMovie,function(index,value){
				if(index==mySCO){
					//need to double check to make sure movie still exists in current versions, which could have changed
					showMovieDivCheck(eCodeLC+value,"first");
				}
				else{
					showMovieDivCheck(SCOfirst,"first");
				}
			});
		}
		else showMovieDivCheck(SCOfirst,"first");
	}
	else if ((eCourseX.resume)) {
		if(eCourseX.bookmark !=""){
			
			console.log("sending bookmark " + eCourseX.bookmark);
			showMovieDivCheck(eCourseX.bookmark, "first");
		}
		else{
			showMovieDivCheck(gMovieArray[0][0],"first");
		}
	} 
	else {
		showMovieDivCheck(gMovieArray[0][0],"first");
	}
	//console.log("1091 courseMoviescomplete is now " + courseMoviesComplete + " and movieComplete length is " + eCourseX.movieComplete.length);
	if(eCourseX.movieComplete.length > 1) courseMoviesComplete += eCourseX.movieComplete.length;
	//console.log("1093 courseMoviescomplete is now " + courseMoviesComplete);
		
}


/*!
 * startEcourse()
 *
 * start the course.
 *
 */
function startEcourse() {
	//This is needed because Start is different for a true SCORM setting, where it depends on which SCO they are in, versus a Totara setting where start will always play the very first movie.
	if(SCORMcourse){
		showMovieDivCheck(SCOfirst);
	}
	else {	
		showMovieDivCheck(gMovieArray[0][0]);
		sendXAPIstatement(xstarted,window.location.href +"/"+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum + "/" + myLessonX);
	}
}


/*!
 * resumeTopic()
 *
 * get the last movie from the JSON object.
 */
//not sure this is being called but it might be necessary for true scorm.
function resumeTopic() {
	topic = eCourseX.currentMovie[mylessonString]; 
	if (topic) {
		showMovieDivCheck(topic);
		sendXAPIstatement(xresumed,window.location.href +"/"+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum +"/"+ mylessonString);
	}
	else {
		alert(resnote);
	}
}



/*!
 * markLessonComplete(lesson:String)
 *
 * Add the lesson name to the lesson complete array in the JSON
 * and update the data store.
 */
function markLessonComplete(lesson, myquizscore) { 
	//console.log("in marklessoncomplete for " + lesson);
	//lessCompDate = lesson + todayDate;
	if(lesson.length > 2){
		var shortlesson = lesson.slice(-2);
	}
	else var shortlesson = lesson;

//	console.log("shortlesson is " + shortlesson);
	var xlessrepkeys = Object.keys(eCourseX.lessReport);

	for(a=0;a<xlessrepkeys.length;a++){
//		console.log("a is " +a+" and num is " + eCourseX.lessReport[a]['num'] + " and shortlesson is " + shortlesson);
		if(eCourseX.lessReport[xlessrepkeys[a]]['num']==shortlesson) {
			var xshortlesson = xlessrepkeys[a];
//		console.log("xshortlesson is " + xshortlesson);
		}
	}
  //  console.log("xshortlesson is " + xshortlesson);
	
	if(eCourseX.lessReport[xshortlesson]['complete']==0 || eCourseX.lessReport[xshortlesson]['complete']=="" || eCourseX.lessReport[xshortlesson]['complete']==null || typeof eCourseX.lessReport[xshortlesson]['complete']=="undefined"){
		
		eCourseX.lessReport[xshortlesson]['complete']=Date.now();
	}
	
	
	if (jQuery.inArray(shortlesson, eCourseX.lessonComplete) < 0) {
	
		eCourseX.lessonComplete.push(shortlesson);
		//console.log("ecourse moviecomplete is " + eCourseX.movieComplete);
		//check for lesson number in the string, and clear those movies from big string
		eCourseX.movieComplete  = eCourseX.movieComplete.filter(function(value){
				return value.substring(0,2)!=shortlesson;
			});
			//console.log("after filterning ecourse moviecomplete is " + eCourseX.movieComplete);	
			//console.log("resetting courseMoviesComplete");
			if(eCourseX.movieComplete.length > 0)courseMoviesComplete = eCourseX.movieComplete.length;
			else courseMoviesComplete = 0;
			for(m=0;m<eCourseX.lessonComplete.length;m++){
				var mymnum = "movieArray"+eCourseX.lessonComplete[m];
				courseMoviesComplete += eval(mymnum).length;
			}	
			//console.log("1179 courseMoviesComplete is now " + courseMoviesComplete);
		sendXAPIstatement(xsatisfied,window.location.href + "/"+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/"+shortlesson);
		if(eCourseX.lprog !="100"){
			sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+ myLessonX + '/100percent');
			eCourseX.lprog = "100";
		}
		//if(!testarea) window.parent.SetDataChunk(JSON.stringify(eCourseX));
		celebrate(shortlesson,"lesson");
		//console.log("calling celebrate for " + shortlesson);
		if(!testarea){
			window.parent.SetDataChunk(JSON.stringify(eCourseX));
			window.parent.CommitData();
		} 
	}   
	//send lesson completion for true scorm
	if (SCORMcourse) {
		
		window.parent.SetReachedEnd();
		if(myquizscore)window.parent.SetScore(myquizscore,100,0);
		else window.parent.SetScore(100,100,0);
		window.parent.SetPassed();
		window.parent.CommitData();
	//	console.log("sent lesson completion");
	}

	//mark the required lesson complete in tracking string
	if(typeof eCourseX.reqLessonsComplete[shortlesson] != "undefined" && eCourseX.reqLessonsComplete[shortlesson] == "no"){
		eCourseX.reqLessonsComplete[shortlesson] = "yes";
	}

	if(Object.values(eCourseX.reqLessonsComplete).includes("no")){
		//console.log("course not finished yet");
		eCourseX.cprog = Math.round((courseReqMoviesComplete/reqdMovsTotal)*100);
		if(eCourseX.cprog > 100) eCourseX.cprog = 100;
	}
	else {
		//course is now complete
	
		if(VLEcourse){
			//console.log("am i getting here?");
			if(eCourseX.coursecomplete == 0)eCourseX.coursecomplete = Date.now();
			window.parent.SetReachedEnd();
			window.parent.SetScore(100,100,0);
			window.parent.SetPassed();
			window.parent.CommitData();
			if(eCourseX.cprog !=100){
				sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/100percentCourseComplete');
				
				eCourseX.cprog = 100;
			}
			
			celebrate(shortlesson,"course");
		}
		
	}
	setLRSdata();
	setChecks();
	

	
	
}

/*!
 * markMovieComplete(movie:String)
 *
 * Add the movie name to the movie complete array in the JSON,
 * set graphical indicators
 * and update the data store.
 */
var lessonQuarter;
var courseQuarter;
function markMovieComplete(movie) { 
	
	//console.log("in markmovieComplete");  
  	if(movie.indexOf("../")==0){
	  	movie = movie.substring(6);
  	}
	//calculate progress and send quarterly statements
	var myLesson = movie.substring(0, movie.indexOf('_')); // epg1v202
  	var myLessonNumber = myLesson.slice(-2); // 02
	var shortMovie = movie.substring(eCode.length);
	
	if (jQuery.inArray(shortMovie, eCourseX.movieComplete) < 0  && !(eCourseX.lessonComplete.includes(myLessonNumber))) {

		 eCourseX.movieComplete.push(shortMovie);
		//check to compare length of movieComplete to gMovieArray-- for percentage statement
		courseMoviesComplete++;
		if(allreqdmovies[shortMovie.substring(0,2)].includes(shortMovie)) {courseReqMoviesComplete++;console.log("bumped coursereqdMovies by one");}
		//console.log("increased courseMoviesComplete by one 1268");
		 lessonMoviesComplete[1]++;

	 	//console.log("cmc is " + courseMoviesComplete+ " and lmc is " + lessonMoviesComplete[1]);
		var lessonTotal = (eval("movieArray" + myLessonNumber)).length;
		lessonQuarter = Math.round(lessonTotal/4);
		courseQuarter = Math.round((gMovieArray.length)/4);
	
		if(courseMoviesComplete > 0 && lessonMoviesComplete[1] > 0){
			switch(lessonMoviesComplete[1]){
				case lessonQuarter: 
					sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+ myLessonX + '/25percent');
					eCourseX.lprog = "25";
					setLRSdata();
					break;
				case lessonQuarter*2:
					sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+ myLessonX + '/50percent');
					eCourseX.lprog = "50";
					setLRSdata();
					break;
				case lessonQuarter*3:
					sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+ myLessonX + '/75percent');
					eCourseX.lprog = "75";
					setLRSdata();
					break;
				case lessonTotal:
					sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+ myLessonX + '/100percent');
					//lessonMoviesComplete[1] = 0; console.log("resetting lessonMoviesComplete");
					eCourseX.lprog = "100";
					setLRSdata();
					
					break;
			}
		}
		
		if(courseMoviesComplete>0 && gMovieArray.length > 0) {
				//console.log("1301 coursemoviecomplete is " + courseMoviesComplete);
			//console.log("courseQuarter is " + courseQuarter);
		
			if(myLangCode == "en"){
				//instead of always starting survey at 25%-- use that only if gMovieArray.length is over 28
				//if gMovieArray.length is < 8, only pop the survey when it's complete.
				//if it's between 9 and 18, pop the survey at 75% 
				//if it's between 18 and 28, pop it at 50%.
				//if it's greater than 28, pop it at 25%
				
				//new plan: if gMovieArray.length <18, pop only at completion.
				//if gt 18, pop at 50 and again at 100.

				switch(courseMoviesComplete){
				/*	case courseQuarter: 
						sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/25percentCourse');
						//eCourseX.cprog = "25";
						
						if((eCourseX.survey != true && !testarea && gMovieArray.length > 28)&& confirm("Complete a brief survey about this course?\nIf pop-ups are blocked, use the Survey link in the navigation bar.")){
							window.open("survey.htm","_new",'top=0,left=0,width=600,height=700,resizable=1,scrollbars=yes');
						}
						document.getElementById('surveyButton').style.display="inline";
						break;*/
					case courseQuarter*2:
						sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/50percentCourse');
						//eCourseX.cprog = "50";
						if((eCourseX.survey != true && !testarea && gMovieArray.length > 18)&& confirm("Complete a brief survey about this course?\nIf pop-ups are blocked, use the Survey link in the navigation bar.")){
							window.open("survey.htm","_new",'top=0,left=0,width=600,height=700,resizable=1,scrollbars=yes');
						}
						document.getElementById('surveyButton').style.display="inline";
						break;
				/*	case courseQuarter*3:
						sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/75percentCourse');
						//eCourseX.cprog = "75";
						if((eCourseX.survey != true && !testarea && gMovieArray.length > 8)&& confirm("Complete a brief survey about this course?\nIf pop-ups are blocked, use the Survey link in the navigation bar.")){
							window.open("survey.htm","_new",'top=0,left=0,width=600,height=700,resizable=1,scrollbars=yes');
						}
						break;*/
					case gMovieArray.length:
						sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/100percentCourseViewed');
						//eCourseX.cprog = "100";
						eCourseX.coursecomplete = Date.now();
						if((eCourseX.survey != true && !testarea)&& confirm("Complete a brief survey about this course?\nIf pop-ups are blocked, use the Survey link in the navigation bar.")){
							window.open("survey.htm","_new",'top=0,left=0,width=600,height=700,resizable=1,scrollbars=yes');
						}
						break;
				}
			}
			else{
				switch(courseMoviesComplete){
					case courseQuarter: 
						sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/25percentCourse');
						//eCourseX.cprog = "25";
						break;
					case courseQuarter*2:
						sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/50percentCourse');
						//eCourseX.cprog = "50";
						break;
					case courseQuarter*3:
						sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/75percentCourse');
						//eCourseX.cprog = "75";
						break;
					case gMovieArray.length:
						sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/100percentCourseViewed');
						//eCourseX.cprog = "100";
						eCourseX.coursecomplete = Date.now();
						break;
				}
			}
			//console.log("courserMC is " + courseReqMoviesComplete + " and reqMovsTtl is " + reqdMovsTotal);
			eCourseX.cprog = Math.round((courseReqMoviesComplete/reqdMovsTotal)*100);
			if(eCourseX.cprog > 100) eCourseX.cprog = 100;
			
		}
		
	}
	if(lessonMoviesComplete[1] == lessonQuarter*2){	
		if((eval("movieArray" + myLessonX)).length > 12){
			  if(!encourage50){
				 encourage("50%");
			  }
		}
	}
	//end progress statements
	
	//update reqTopicsComplete
	if(reqTopicsComplete.includes(movie) ){
		reqTopicsComplete[reqTopicsComplete.indexOf(movie)][1] = "yes";

	}
	//calculate lesson completion
	if(lessonCheck=="reqTopics"){
		var notdone = 0;
		for(i=0;i<reqTopicsComplete.length;i++){
			
			if(reqTopicsComplete[i][1]=="yes") notdone++;
		}
		if(notdone=reqTopicsComplete.length) {
			markLessonComplete(myLesson);
		}
	}
	
	else if (lessonCheck=="viewAll"  && !(hasquiz.includes(myLessonX))){
		
		var alldone = true;
		for(a=0;a<allreqdmovies[myLessonX].length;a++){
			if(!eCourseX.movieComplete.includes(allreqdmovies[myLessonX][a])){
				alldone = false;
				break;
				}	
		}
		if(alldone){
			markLessonComplete(myLessonX);
		}
		

	}
	
	
	setLRSdata();
	
	setChecks();
}



/*!
 * setChecks()
 *
 * Instantly find the recently played item and mark it completed.
 * Also make sure completed items are marked as well
 */

function setChecks() { 
	//console.log("in setChecks front");
	$('.playing button').attr('aria-pressed', 'true');
	
	if (eCourseX) {
		$.each(eCourseX.lessonComplete, function(i,v){
			//for anything here, go thru moviearray+v and mark each movie complete.
			$.each(eval("movieArray"+v), function(s,j){
				
				$('#mcheck_' + j[0] + ' button').attr('aria-describedby', 'secretChk');
				$('#mcheck_' + j[0] + ' .toc_link').addClass('checked');
			});
		});
		
		$.each(eCourseX.movieComplete, function (i, v) {
			var vx = eCodeLC+v;
		//	console.log("in setChecks for " + vx);
			$('#mcheck_' + vx + ' button').attr('aria-describedby', 'secretChk');
			$('#mcheck_' + vx + ' .toc_link').addClass('checked');
		//	if (tocWindow && !tocWindow.closed) {
		//		//alert("about to reload?");				
		//		tocWindow.location.reload();
		//	}
		});
	}
	if (eCourseX) {
		$.each(eCourseX.favorites, function (i, v) {
			var vx = eCodeLC+v;
			$('#fave_' + vx + ' button').attr('aria-describedby', 'secretFave');
			$('#fave_' + vx + ' button').removeClass('starOff');
			$('#fave_' + vx + ' button').addClass('starOn');
			$('#fave_' + vx + ' button').attr('title', faveoff);
			$('#fave_' + vx + ' button').attr('aria-label', faveoff);
		});
	}
	
	if (eCourseX) {
		$.each(eCourseX.mynotes, function (i, v) {
			//console.log(v);
			var vx = eCodeLC+v;
			$('#fave_' + vx + ' button').attr('aria-describedby', 'secretNote');		
			$('#fave_' + vx + ' button').removeClass('starOff');
			$('#fave_' + vx + ' button').removeClass('starOn');
			$('#fave_' + vx + ' button').addClass('noteShow');
			$('#fave_' + vx + ' button').attr('title',noteshow);
			$('#fave_' + vx + ' button').attr('aria-label',noteshow);
		});
	}

	//$('.playing').removeClass('playing');
}

function setNoteIcon(){
	$('#fave_' + myObjectID + ' button').attr('aria-describedby', 'secretNote');
	$('#fave_' + myObjectID + ' button').removeClass('starOff');
	$('#fave_' + myObjectID + ' button').removeClass('starOn');
	$('#fave_' + myObjectID + ' button').addClass('noteShow');
	$('#fave_' + myObjectID + ' button').attr('title', noteshow);
	$('#fave_' + myObjectID + ' button').attr('aria-label', noteshow);
}

function unsetNoteIcon(){
	if(eCourseX.favorites.indexOf(myObjectID)>-1){
		$('#fave_' + myObjectID + ' button').attr('aria-describedby', 'secretFave');
		$('#fave_' + myObjectID + ' button').removeClass('noteShow');
		$('#fave_' + myObjectID + ' button').addClass('starOn');
		$('#fave_' + myObjectID + ' button').attr('title', faveoff);
		$('#fave_' + myObjectID + ' button').attr('aria-label', faveoff);	
	}
	else{
	    $('#fave_' + myObjectID + ' button').removeAttr('aria-describedby');
		$('#fave_' + myObjectID + ' button').removeClass('noteShow');
		$('#fave_' + myObjectID + ' button').addClass('starOff');	
		$('#fave_' + myObjectID + ' button').attr('title', faveon);
		$('#fave_' + myObjectID + ' button').attr('aria-label', faveon);
	}		
}

function setFavorite(myFave){
	var shortFave = myFave.substring(eCode.length);

	if ($('#fave_' + myFave + ' button').hasClass('noteShow')){ 
	//open correct popup depending on page type
	showMovieDivCheck(myFave);
		setTimeout(function(){
			if(eCourseX.textonly == 'ON'|| myType.indexOf("html")>-1){
				document.getElementById('userNote').scrollIntoView(true);
			}
			else if(myType == "vid"){
				if(transWindow && !transWindow.closed){
					transWindow.document.getElementById('userNote').scrollIntoView(true);
				}
				else {
					openTranscript('note');
				} 
			}
			/*if(myType === 'html1'){		
				openPrintVersion(myMovieTitle);
			}
			else if(myType === 'html2'){
				openPrintVersion2(myMovieTitle);
			}
			else if(myType === 'html3'){		
				openPrintVersionEmbed(myMovieTitle);
			}
			else {
				showMovieDivCheck(myFave);
				openTranscript('note');
			}*/
		},500);
	}
	else {
		//check if current movie is in favorites already
		if($.inArray(shortFave,eCourseX.favorites)!=-1){
			//if it's already a favorite, unfavorite it
			sendXAPIstatement(xunfavorited,window.location.href  + "/"+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/"+myLessonX + "/" + myObjectID);
			for(var i=0;i<eCourseX.favorites.length; i++){
				if(eCourseX.favorites[i] == shortFave){
					eCourseX.favorites.splice(i,1);
				}
			}
			setLRSdata();
			$('#fave_' + myFave + ' button').removeClass('starOn');	
			$('#fave_' + myFave + ' button').addClass('starOff');	
			$('#fave_' + myFave + ' button').attr('title',faveon);	
			$('#fave_' + myFave + ' button').attr('aria-label',faveon);
			$('#fave_' + myFave + ' button').removeAttr('aria-describedby');
		}
		else{
			//add to eCourseX.favorites array
			sendXAPIstatement(xfavorited,window.location.href  + "/"+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/"+myLessonX + "/" + myFave);
			eCourseX.favorites.push(shortFave);
			setLRSdata();
			$('#fave_' + myFave + ' button').removeClass('starOff');
			$('#fave_' + myFave + ' button').addClass('starOn');
			$('#fave_' + myFave + ' button').attr('title', faveoff);
			$('#fave_' + myFave + ' button').attr('aria-label', faveoff);	
			$('#fave_' + myFave + ' button').attr('aria-describedby', 'secretFave'); 
		}
	}
}



/* Expand Lesson in TOC */
$(document).ready(function() { 
	if (courseDesc != "legacySSEL"){
    	$(".lheader").click(function() {
     	   $header = $(this); 
     	   $icon = $header.find('img');
      	   $content = $header.next();
        
     	   $content.slideToggle("800", function () {
           		if ($content.is(":visible")) {
              		$icon.attr('src', hideImg);
			  		$icon.attr('title', lhide);
              		$header.attr('aria-expanded', 'true');
					$('.lessContainer').css('display','inline')
          		}
          		else {
             		$icon.attr('src', showImg);
			  		$icon.attr('title', lshow);
            		$header.attr('aria-expanded', 'false');
          		}
       		});
    	});
	}
});



/*!
 * highlightTOC(mov:String)
 *
 * Highlights ToC items that are currently playing. Also tags that item with a 'playing' class
 *
 */
function highlightTOC(mov, splash) { 
	//console.log("highlghting " + mov);
	
	$(' .toc_link').removeClass('playing');
//	alert("highlightoc");
	setChecks();
	/*! mark as being played right now*/
	
	$('#mcheck_' + mov).css('color', 'black');
	$('#mcheck_' + mov +' .toc_link').addClass('playing');
//	$('#mcheck_' + mov +' button').attr('aria-current','page'); -- might not need this if aria-pressed is used?
											  
	if(splash == "first"){	
		var currentItem = document.getElementById($('.playing').parent().attr('id'));
		alternativeScrollIntoView(currentItem);
	}
	else{
		scroll_position1 = $('#panel1').scrollTop(); 
		var currentItem = document.getElementById($('.playing').parent().attr('id'));
		alternativeScrollIntoView(currentItem);
	}
}


function alternativeScrollIntoView(TOCitem) { 	
	//console.log("alt scroll " + TOCitem);
	if (TOCitem == null) return;
	//	alert(TOCitem.getClientRects()[0]);
	if (TOCitem.getClientRects()[0]) {
		$("#panel1").scrollTop(0);
		var bottomActual = TOCitem.getClientRects()[0].bottom;
		var myPanelHt = $("#panel1").height();
		if (bottomActual == 0) return;
			
		var scrollPoint = bottomActual + 100;
		if (scrollPoint > $("#panel1").height()){
			$("#panel1").scrollTop(scrollPoint - 350);
		}
	}
}

/* visual indication of 50% and 100% lesson complete */
var encourage50 = false;
function encourage(howfar){

	if (howfar == "50%") {
		encourage50 = true;
		$('#bottomRow').addClass('lesshalfDone');
		$('#encourage').html(completemsg1 + howfar + completemsg2);
	}
	$('#encourage').css('display','block');
		
	setTimeout(function(){
		$('#encourage').css('display','none');
		$('#bottomRow').removeClass('lesshalfDone');
	}, 2000);
	encourage50 = false;
}


function celebrate(lesson, mymsg){
	var lessontotal = (eval("movieArray" + lesson)).length;
	//course complete message
	if (mymsg == "course"){
		$('#encourage').html(completecrsmsg);
		$('#bottomRow').addClass('crsDone');
		$('#encourage').css('display','block');
	}
	//Lesson complete message
	//else if ((mymsg == "lesson") && (lessontotal > 1)  && (courseDesc != "recLess")){
	else if ((mymsg == "lesson") && (lessontotal > 1)){
		$('#encourage').html(completemsg);
		$('#bottomRow').addClass('lessDone');
		$('#encourage').css('display','block');
	}

		setTimeout(function(){
			$('#encourage').css('display','none');
			$('#bottomRow').removeClass('lessDone crsDone');
		}, 2000);

}

 /* POPUP FUNCTIONS*/
var transWindow;
//TRANSCRIPT WINDOW
function openTranscript(source) { 
	var noteInProgress = checkMyNoteState();
	if(noteInProgress){
		if (confirm(noteprogressClick)){
			$('#noteEntry').css('display', 'none');
			makeNewNote = false;
			openTransSafe(source);	
		}
		else{
			window.document.getElementById("userNote").focus();
		}

	}
	else{
		openTransSafe(source);	
	}
   
	
}

function openTransSafe(source){
	var myPage = "rc_common/transcript_win.htm";
	
	if(source === "button") {
	  transWindow = window.open(myPage,'Transcript','top=100,left=50,width=600,height=700,resizable=1,scrollbars=yes');
	  transWindow.focus();
	  sendXAPIstatement(xinteracted,window.location.href +'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/"+ myLessonX + "/transcriptWindow/" + myPage );	
  }

  else if (source === "note")  {
	
			transWindow = window.open(myPage,'Transcript','top=100,left=50,width=600,height=700,resizable=1,scrollbars=yes');
			setTimeout(function(){$("#noteEntry",transWindow.document).css('display','block');
				transWindow.document.getElementById("userNote").focus();},1000);
			
			
  }

  else if(source === "function") {  
	  //if the window is already open, update the document -->
	  if(transWindow && !transWindow.closed) {  
			transWindow = window.open(myPage,'Transcript','top=100,left=50,width=600,height=700,resizable=1,scrollbars=yes');
			transWindow.focus();
	  }
	 
  }	
  if(SCORMcourse){
	$("#takeNote2", transWindow).remove();
  }
}

function openTransDemoACC(){
