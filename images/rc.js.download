/*!
 ************************************************************************************************
 quiz functions 
 ***********************************************************************************************/
var passingScore=80;
var myScore=0;
var score = 0;

function setAnswerFlex(form) {  
	var currElt;
	var currSelection;
	var numQues = userAns.length;
	
	for (i=0; i<numQues; i++) {
		radio_name = "ques" + [i+1];
		var oRadio = document.forms[0].elements[radio_name]; 
		for(var j = 0; j < oRadio.length; j++) {  
			if(oRadio[j].checked) {  
				userAns[i] =  oRadio[j].value; 
				break; 
			} 
			else { 
				userAns[i] = "x";
			}
		}   
	} 
}



function getScore() { 
	window.opener.opener.wrongAnswers = "**item/correct/user/**";
	var blnCorrect; 
	var numQues = correctAns.length; 
	for (i=0; i<numQues; i++) {
		blnCorrect = false;
		if (ans[i] == correctAns[i]){
			score++;
			blnCorrect = true;
		}
		else{
			window.opener.opener.wrongAnswers += "*" + (i+1) + "/" + correctAns[i] + "/" + ans[i] + "*";
		}
		//**************************
		var selectedAns="";
		if (!ans[i]) selectedAns = "x";
		else selectedAns = ans[i];
		//**************************
	} 
	decimalScore = Math.round(score/numQues*100); 
	pctscore = decimalScore + "%";
	myScore = decimalScore; 
	if (myScore >= passingScore) {
		//call storeQuizResult on same level as this page
		storeQuizResult();
	}
	else { 
		passFailingQuiz();
	}
}

function storeQuizResult() {   
   		//get myObjectID value from base page myObjectID
    myObjectID = window.opener.opener.myObjectID; // m345_0_a
		//get moduleShort value by substringing 
	moduleShort = myObjectID.substring(0, myObjectID.indexOf('_')); // m345
	 	//call down to base page in order to make the jQuery work right???
  	window.opener.opener.BasePageStoreQuizResult(myObjectID, moduleShort, myScore);
}

//send xAPI statement that quiz has been failed
function passFailingQuiz() {   
