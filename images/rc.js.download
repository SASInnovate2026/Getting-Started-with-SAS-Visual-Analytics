function insertMultiVicon(){
	if(window.location.href.indexOf("learn.sas.com")>-1 ||window.location.href.indexOf("learnstage.sas.com")>-1 || window.location.href.indexOf("sww.sas.com/cbt/totara")>-1 || window.location.href.indexOf("sww.sas.com/cbt/Library_rc/TSCORM")>-1 ){
		document.getElementById("multiicon").innerHTML = '<img width="20px" height="20px" src="rc_common/multiple-topic-bl.png">';
		document.getElementById("multivstepsDLC").style.display="none";
	}
	else{
		document.getElementById("multiicon").innerHTML='<img width="20px" height="20px" src="rc_common/multi_orange2.png" class="vleImage">';
		document.getElementById("multivstepsT").style.display="none";
	}
}

function setSelector(){
	
	if(document.forms['myphpform'].elements['courseVers'].value != ""){
		xtraselect = document.forms['myphpform'].elements['courseVers'].value;
		eCourseX.xtra = document.forms['myphpform'].elements['courseVers'].value;
		$('#selected').text($(this).text());
		for (i=0;i<selectoptions.length;i++){
			if(selectoptions[i][0] == xtraselect) currentSelect = selectoptions[i][1];
		}
 		document.getElementById('currSel').innerHTML = currentSelect;
		
		rewriteCourseTOC();
		
	}
	
}

function setPrintSelector(){
	
	if(document.forms['myphpform'].elements['courseVers'].value != ""){
		xtraselect = document.forms['myphpform'].elements['courseVers'].value;
		$('#selected').text($(this).text());
		for (i=0;i<selectoptions.length;i++){
			if(selectoptions[i][0] == xtraselect) document.getElementById("currentSelect").innerHTML = selectoptions[i][1];
		}
 		//document.getElementById('currSel').innerHTML = currentSelect;
		
	}
	//console.log("doing the change");
	$('#pracsoln .select').each(function(n){
		if($(this).hasClass(xtraselect)) $(this).show();
		else $(this).hide();
		//console.log("did it?");
	   });
	   $('#pracnosoln .select').each(function(n){
		if($(this).hasClass(xtraselect)) $(this).show();
		else $(this).hide();
		//console.log("did it?");
	   });
	   $('#demosteps .select').each(function(n){
		if($(this).hasClass(xtraselect)) $(this).show();
		else $(this).hide();
		//console.log("did it?");
	   });
}

var textonly = false;
function goText(fromwhere){
	//check if it's in regular state or text state
	//console.log("TURNING OFF OVIES");
	if(fromwhere=="frominit"){
		
	//	$("#transcript_panel").hide();
		$('#overlayContainer').css('border','orange');
		//set to text state in tracking
		eCourseX.textonly = 'ON';
		if(eCourseX.bookmark){
			showMovieDivCheck(eCourseX.bookmark);
		}
		else showMovieDivCheck(gMovieArray[0][0]);
		
		$('#landmarkDiv4').text(vidyesbtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#landmarkDiv4'));
		$('#noMovie').text(vidyesbtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#noMovie'));
		$('#noMovie2').text(vidyesbtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#noMovie2'));
		$('#videoNotice').css('display','block');
	}
	
	else if(eCourseX.textonly == 'OFF'){
	//if its in regular state, go to text state
	$('#overlayContainer').css('border',' orange');
	//set to text state in tracking
		eCourseX.textonly = 'ON';
		showMovieDivCheck(myorigmov);
		//console.log("showing movie " + myMovie);
		$('#landmarkDiv4').text(vidyesbtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#landmarkDiv4'));
		$('#noMovie').text(vidyesbtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#noMovie'));
		$('#noMovie2').text(vidyesbtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#noMovie2'));
		$('#videoNotice').css('display','block');
		//}
	}
	else{
	//if its in text state, go to regular state
		$('contentContainer').css('border','none');
		//set to movie state in tracking
		eCourseX.textonly = 'OFF';
		showMovieDivCheck(myorigmov);
	//	console.log("showing movie " + myMovie);
		$('#landmarkDiv4').text(vidnobtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#landmarkDiv4'));
		$('#noMovie').text(vidnobtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#noMovie'));
		$('#noMovie2').text(vidnobtn);
		$("<span aria-hidden='true'> (Alt+W)</span>").appendTo($('#noMovie2'));
		$('#videoNotice').css('display','none');
		//}
	}
}


function getuserID(){
	//console.log("window location is " + window.location.href);
	if(window.location.href.indexOf("sww.sas.com")>0 || window.location.href.indexOf("sww2.sas.com")>0) testarea = true;
	else if(window.location.href.indexOf("learn.sas.com")>0 ||window.location.href.indexOf("learnstage.sas.com")>0  || window.location.href.indexOf("totara")>0 || window.location.href.indexOf("learndev")>0) VLEcourse = true;
    else if(window.location.href.indexOf("cloud.scorm") > 0 || window.location.href.indexOf("contentcontroller") > 0)	SCORMcourse = true;
	else if(window.location.href.indexOf("vle.sas.com") > 0 || window.location.href.indexOf("vlestage.sas.com")>0) VLEcourse = true;
	else if(window.location.href.indexOf("synegen")>0)VLEcourse = true; 
	
	return new Promise(function(resolve, reject){
		if(versNum == "verUnknown"){
			$.ajax({
				type: "GET",
				url: "./imsmanifest.xml",
				dataType: "xml",
	
				error: function (e) {
					//alert("An error occurred while processing XML file");
					console.log("XML for versNum reading Failed: ", e);
				},
	
				success: function (response) {
	 
					$(response).find("resource").each(function () {
						 $(this).find('file').each(function(){
							if($(this).attr('href')){
								//don't pull from titles file
								if($(this).attr('href').indexOf('.json')>1 && $(this).attr('href').indexOf('titles')==-1){
									var wholeName = $(this).attr('href');
									var partName = wholeName.substring(wholeName.indexOf("_")+1);
									versNum = partName.substring(0,partName.indexOf("_"));
									//console.log(versNum);
								}
							} 
						 });        
					});
				}
			});
		}
        if(!testarea) actorID = window.parent.GetStudentID();
		else actorID = "00000";
		if(actorID == "" || actorID == " ") actorID = "00000";
		//console.log("and now actorid is " + actorID);
        if(typeof actorID != "undefined"){
            actor2 = {
                "objectType": "Agent",
                "name":actorID,
                "account":{"name":actorID,"homePage":"http://www.sas.com"}  
            }
        }
        resolve(actorID, versNum);
    });
}		

/*!
 * getLRSdata()
 * 
 * general method to pull stored progress
 * data for in-lesson tracking.
 * checks our LRS first, unless it is
 * a "true SCORM" course, in which 
 * case it checks the LMS. 
 *
 */
function getLRSdata(myid){
    return new Promise(function(resolve, reject){
        var mystoreddata;
      //  console.log("getting LRS data and window.parent.location is " + window.parent.location);
	    myactivityIRI = window.location.href.substring(0,window.location.href.indexOf(".com/"))+ ".com/"+ eCode;
       //if it's true SCORM
		if(SCORMcourse){
            mystoreddata = window.parent.GetDataChunk();
          //  console.log("got this data from LMS " + mystoreddata);
            if ((!mystoreddata) || (mystoreddata == null) || (mystoreddata == 'undefined') || mystoreddata == "cleared") { 
                console.log("no data in LMS");
                mystoreddata = "nodata";
            }
            console.log(" SCORM course-- my storeddata is " + mystoreddata);
            resolve(mystoreddata);
        }
		//or if it is the test area
		else if(actorID == "00000" && (window.location.href.indexOf("sww.sas.com")>0)){
			mystoreddata = "nodata";
            console.log("my storeddata is " + mystoreddata);
            resolve(mystoreddata);
		}
		//if it's not test area but user doesn't have valid ID
		else if(testarea!=true && actorID == "00000" ){
			mystoreddata = "nodata";
            console.log("default user -- my storeddata is " + mystoreddata);
            resolve(mystoreddata);
		}
		//non-scorm, non-test, good user id
        else if(actor2.name != "Default User" && actor2.name != "00000"){
			
			console.log("ajaxing for getLRS");
          
            ajaxstring = myactivityIRI+'&*'+actor2.account.name+'/'+fakeid;
            $.ajax({
                type: "POST",
                url:xAPIgetURL,	
                xhrFields : {
                    withCredentials : true
                },
                data:{
                //    "actorAccount":actor2.account.homePage,
                //    "actorName":actor2.account.name,
                //    "activityPath": myactivityIRI
                "mydata":ajaxstring
                },
                
                crossDomain : true,
                success: function(data){
                    //report back with data from LL state
                    console.log("got LL state as follows: " + data);
					//don't write error screen to eCourseX.
					if(data.indexOf("<!DOCTYPE")>-1 || data.length<4 || data=="Unexpected input")mystoreddata = "nodata";
					else  mystoreddata = data;
                    //console.log("my storeddata is " + mystoreddata);
                    resolve(mystoreddata);
                },
                error: function(){
                    console.log("error pulling data from LRS. starting over.");
                    mystoreddata = "nodata";
                    console.log("my storeddata is " + mystoreddata);
                    resolve(mystoreddata);
                }
            
            });
        }
		//shouldn't ever get to this point
        else{
            mystoreddata = "nodata";
            console.log("Fell through the IFs in getLRS and my storeddata is " + mystoreddata);
            resolve(mystoreddata);
        }
    });  
}

function processTrackData(mydata){
   // console.log("in processing data and mydata is " + mydata);
    return new Promise(function(resolve, reject){
       // console.log("processing data");
	  //need to check data from LRS and possibly clean it up if there are extra characters at the end-- it should be JSON ready. But it comes back as a string (I think). 
	/* if(mydata != "nodata"){
		var firstBracket = mydata.indexOf("}");
		var secondBracket = mydata.indexOf("}",firstBracket+1);
		var myEndPoint = mydata.indexOf("}",secondBracket+2);
		var mydata2 = mydata.substring(0,myEndPoint+1);	
	 }  
	 else*/
	
	 var mydata2 = mydata;
	 var curlyb = 0;
	 for(i=0;i<mydata2.length;i++){
		if(mydata2.charAt(i)=="{") curlyb++;
		else if(mydata2.charAt(i) == "}") curlyb--;
	 }
	
	 if(curlyb != 0) {
		console.log("off balance");
		if(mydata2.charAt(mydata2.length-1)=="}" && mydata2.charAt(mydata2.length-2)=="}"){
			mydata2 = mydata2.slice(0,-1);
			console.log("mydata 2 is now " + mydata2);
		}
		else if(mydata2.indexOf(',"courseEdit":[]}')>0 && mydata2.length-mydata2.indexOf(',"courseEdit":[]}')<27){
			//mydata2 = mydata2.slice(0,-8);
			mydata2 = mydata2.substr(0,mydata2.indexOf(',"courseEdit":[]}')+17);
			console.log("mydata2 is now " + mydata2);
		}
		
		
	 }
	 		//console.log("mydata2 is " + mydata2);																																
       if(SCORMcourse){
            if(mydata2.length < 1 || mydata2 == null || mydata2 == "nodata"){
                eCourseX = createCoursexapiJSON(eCode);
                console.log("no data, starting fresh...");
            }
            else {
                eCourseX = JSON.parse(mydata2);
			//	setChecks();
            }
            dataLoaded = "yes";
        }
        else{

			if(VLEcourse) var myLMSdata = window.parent.GetDataChunk();
			else var myLMSdata = "noLMS";
			console.log("my LMSdata is " + myLMSdata);
			console.log("char at -1 is " + myLMSdata.charAt(myLMSdata.length-1));
			if(myLMSdata.charAt(myLMSdata.length-1)=="%") myLMSdata=myLMSdata.substring(0,myLMSdata.length-1)+"}";
			console.log("mylmsdata is now " + myLMSdata);
			//No state found -- need to check data chunk to see if there is anything there.
			if(mydata2.indexOf("No State") > -1 || mydata2 == "nodata"){
				if((myLMSdata == null) || (myLMSdata == 'undefined') || (myLMSdata == "cleared") || myLMSdata == "<anonymous>" || myLMSdata == "" || myLMSdata == "noLMS"){
					//could put warning for users here-- test if it's learn.sas.com, and if so, warn them that progress won't be saved
               		console.log("no state found anywhere, starting fresh");
                	eCourseX = createCoursexapiJSON(eCode);
				}
                else{
					console.log("no data from LRS but good data from LMS, setting eCourseX now");
					//need to check to make sure that ecode has not changed in scormddlid
					var myolddata = JSON.parse(myLMSdata);
					if(myolddata['eCode'] == eCode)	{
						console.log("using data from LMS");
						eCourseX = JSON.parse(myLMSdata);
					}
					else {
						console.log("data from lrs didn't match ecode, starting fresh");
                		eCourseX = createCoursexapiJSON(eCode);
					}
					
				}
            }
            else{
				if((myLMSdata == null) || (myLMSdata == 'undefined') || (myLMSdata == "cleared") || myLMSdata == "<anonymous>" || myLMSdata == ""){
					console.log("good data from LRS but nothing from LMS, so using LRS data");
					eCourseX = JSON.parse(mydata2);
				}
				else{
					var lrsdata = JSON.parse(mydata2);
					var lmsdata = JSON.parse(myLMSdata);
					if(lmsdata['eCode'] == lrsdata['eCode']){
						if(typeof lrsdata['timestamp']!='undefined' && typeof lmsdata['timestamp'] !='undefined'){
							//if LRS tracking has been updated more recently-- need to check and make sure that we haven't cleared just LRS data
							if(lrsdata['timestamp']>lmsdata['timestamp'] && (mydata2.length >= myLMSdata.length)){
								eCourseX = lrsdata;
							}
							else eCourseX = lmsdata;
						}
						else if(typeof lrsdata['timestamp'] != 'undefined') eCourseX = lrsdata;
						else if(typeof lmsdata['timestamp'] != 'undefined') eCourseX = lmsdata;
						else eCourseX = createCoursexapiJSON(eCode);
					}
					else{
						//lmsdata is pulling from previous version, default to newer version from lrs.
						if(lrsdata['eCode'] == eCode) {
							console.log("using lrs data because it matches current ecode");
							eCourseX = lrsdata;
						}
						else eCourseX = createCoursexapiJSON(eCode);
					}					

				}
/*				else if(mydata2.length > myLMSdata.length){
                	console.log("data from LRS is best, using that...")
					eCourseX = JSON.parse(mydata2);
				}
				else {
					console.log("best data from LMS, using that...")
					eCourseX = JSON.parse(myLMSdata);
				}*/
             //   setChecks();
            }
            dataLoaded = "yes";
        }
        if(typeof(eCourseX.eCode) == 'undefined'){
            console.log("had data, but it was bad so starting over");
            eCourseX = createCoursexapiJSON(eCode);
        }
		
        resolve(dataLoaded);
    });  
}

var unreqlessons="@";//used for creating json file
var allreqdmovies = [];
var reqdMovsTotal = 0;
function initPageJS(){
    return new Promise(function(resolve, reject){
		if(familycode == "unknown" && eCode.toUpperCase() in famCode) familycode = famCode[eCode.toUpperCase()];
		if(versNum == "verUnknown"){
			$.ajax({
				type: "GET",
				url: "./imsmanifest.xml",
				dataType: "xml",
	
				error: function (e) {
					//alert("An error occurred while processing XML file");
					console.log("XML for versNum reading Failed: ", e);
				},
	
				success: function (response) {
	 
					$(response).find("resource").each(function () {
						 $(this).find('file').each(function(){
							if($(this).attr('href')){
								//don't pull from titles file
								if($(this).attr('href').indexOf('.json')>1 && $(this).attr('href').indexOf('titles')==-1){
									var wholeName = $(this).attr('href');
									var partName = wholeName.substring(wholeName.indexOf("_")+1);
									versNum = partName.substring(0,partName.indexOf("_"));
								//	console.log(versNum);
								}
							} 
						 });        
					});
				}
			});
		}
		console.log("familycode is now "+ familycode);
       //set var to indicate when page is ready, initialize to no
		var allset = "no";
        $('#countdownButt').hide();
		if(SCORMcourse){
            useXAPI = false; 
			mySCO = window.parent.mySCO;//gets set in indexAPIcc. 
			//console.log("mySCO is " + mySCO);
			var whicharray = "movieArray" + mySCO;
			SCOfirst = eval(whicharray)[0][0];
            SCOlast = eval(whicharray)[eval(whicharray).length-1][0];
			$("#scormFooter").css('visibility','visible');
			$("#courseHeader").css("display","none");
			$("#rev2").css("display","none");
			//if(eCourseX.currentMovie.includes(eCodeLC+mySCO)) eCourseX.bookmark = eCourseX.currentMovie[]	       
        }
		else if(testarea){
			$("#courseHeader").css("display","block");
			useXAPI = false;
		
		}
		else if(window.location.href.indexOf("synegen")!=-1){
			useXAPI = false;
			$("#courseHeader").css("display","none");
			$("#rev2").css("display","none");
			$("#scormFooter").css("display","none");
		}
		else if(actorID == "00000"){
			//make sure they aren't in the VLE/Totara
			if(window.location.href.indexOf("vle.sas.com")>0 || window.location.href.indexOf("vlestage.sas.com")>0 || window.location.href.indexOf("learn.sas.com")>0 || window.location.href.indexOf("learnstage.sas.com")>0 ){
				useXAPI = false; 
			}
			else if(window.location.href.indexOf("synegen")!=-1){
				useXAPI = false;
				$("#courseHeader").css("display","none");
				$("#rev2").css("display","none");
				$("#scormFooter").css("display","none");
			}
			else if(window.location.href.indexOf("learnstage")!=-1){
				useXAPI = true;
				$("#courseHeader").css("display","none");
				$("#rev2").css("display","none");
				$("#scormFooter").css("display","none");
			}
			else {
				useXAPI = true;
           		$("#courseHeader").css("display","none");
			    $("#rev2").css("display","none");
				$("#scormFooter").css("display","none");
			}
			
		}
        else{
            useXAPI = true;
            $("#courseHeader").css("display","none");
			$("#rev2").css("display","none");
			$("#scormFooter").css("display","none");
        }
		if(typeof newQuizlabel != "undefined" && newQuizlabel.length > 1) quizlabel = newQuizlabel;
        if(typeof eCourseX.eCode == 'undefined') eCourseX=createCoursexapiJSON(eCode);
		if(eCourseX.eCode != eCode) eCourseX.eCode = eCode;
		if(typeof eCourseX.favorites=="undefined") { eCourseX.favorites=[];}
		if(typeof eCourseX.mynotes == "undefined") { eCourseX.mynotes=[];}
		if(typeof eCourseX.textonly == "undefined"){eCourseX.textonly = 'OFF';} 
		if(typeof eCourseX.mymode == 'undefined') {eCourseX.mymode="light";}
		if(typeof eCourseX.myfontsize == 'undefined') {	eCourseX.myfontsize="100";}
		if(typeof eCourseX.xtra == 'undefined') eCourseX.xtra = "none";
		else if(eCourseX.xtra != "none") xtraselect = eCourseX.xtra;
		if(myLangCode=="pt-br") eCourseX.captions = "showing";
		if(typeof eCourseX.bookmark == 'undefined') {	console.log("resetting bookmark");eCourseX.bookmark=gMovieArray[0][0];}
		else{
			var bkmkecode = eCourseX.bookmark.substring(0,(eCourseX.bookmark.indexOf("_")-2));
		//	console.log("bkmkecode is " + bkmkecode);
			var goodbkmk = false;
			for(g=0;g<gMovieArray.length;g++){
				if(eCourseX.bookmark == gMovieArray[g][0]) {
					goodbkmk = true;
				//	console.log("bookmark is good!");
				}
			}
			if(bkmkecode != eCodeLC || !goodbkmk){ console.log("resetting bookmark again");eCourseX.bookmark = gMovieArray[0][0];}
		} 
		
		if(typeof eCourseX.reqLessonsComplete == "undefined"){eCourseX.reqLessonsComplete = {};}
		else{
			//need to check and see which lesson(s) have been added or removed
			var currLessons=[];
			for(b=0;b<lessonTitles.length;b++){
				var nokeyword = true;
				for(j=0;j<optlesstitles.length;j++){
					if(lessonTitles[b][1].indexOf(optlesstitles[j])>-1){
						nokeyword = false;
						//console.log("found an unrequired lesson");
					} 
				}
				for(k=0;k<optkeywords.length;k++){
					if(lessonTitles[b][1].indexOf(optkeywords[k])>-1){
						nokeyword = false;
						//console.log("found an unrequired lesson");
					} 
				}
				if(nokeyword) currLessons.push(lessonTitles[b][0].slice(-2));
			}
			//	console.log("currLessons is " + JSON.stringify(currLessons));
			var reqLessonNums = Object.keys(eCourseX.reqLessonsComplete);
			//run thru and verify that all nums listed as keys in rLC are actual lessons
			for(a=0;a<reqLessonNums.length;a++){
				if(currLessons.includes(reqLessonNums[a])){
			//	console.log("this lesson is good and required " + reqLessonNums[a]);		
				}
				else{
				//	console.log("deleting lesson " + reqLessonNums[a] + " from reqLessonsComplete");
					delete eCourseX.reqLessonsComplete[reqLessonNums[a]];
				}
			}
			//now check if there are new lessons that aren't yet in rLC
			for(c=0;c<currLessons.length;c++){
				if(reqLessonNums.includes(currLessons[c])){
					//do nothing
				}
				else{
					eCourseX.reqLessonsComplete[currLessons[c]] = 'no';
				}
			}
			
			//now check to see if all are complete, and then check cmi.core.lesson_status
			if(VLEcourse) var totaracomplete = window.parent.SCORM_CallLMSGetValue('cmi.core.lesson_status');

			if(Object.values(eCourseX.reqLessonsComplete).includes("no")){
				//console.log("course not finished yet");
			}
			else if(totaracomplete == "incomplete"){
				console.log("resending course completion");
			
				if(VLEcourse){
					//console.log("am i getting here?");
					if(eCourseX.coursecomplete == 0)eCourseX.coursecomplete = Date.now();
					eCourseX.cprog = 100;
					window.parent.SetReachedEnd();
					window.parent.SetScore(100,100,0);
					window.parent.SetPassed();
					window.parent.CommitData();
					if(eCourseX.cprog !="100"){
					//	sendXAPIstatement(xprogressed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/100percentCourseComplete');
						
						eCourseX.cprog = "100";
					}
					
/*					celebrate(shortlesson,"course");*/
				}
				
			}
		}
		if(typeof eCourseX.lessonCheck == "undefined"){eCourseX.lessonCheck = "viewAll"};
		if(typeof eCourseX.courseCheck == "undefined"){eCourseX.courseCheck = "all"};
		if(typeof eCourseX.cprog == "undefined"){eCourseX.cprog = "0"};
		if(typeof eCourseX.timestamp == "undefined"){const currentDate = new Date();
			const timestamp = currentDate.getTime();eCourseX.timestamp = timestamp;}
		//add courseEdit timestamp.
		if(typeof eCourseX.courseEdit == "undefined") eCourseX.courseEdit=[];
		if(typeof courseEditDate != "undefined" && !eCourseX.courseEdit.includes(courseEditDate)) eCourseX.courseEdit.push(courseEditDate);
			var lessReportkeys = Object.keys(eCourseX.lessReport);
		if(typeof eCourseX.lessReport == "undefined"){eCourseX.lessReport = {};}
		else if(lessReportkeys.length != lessonTitles.length){
			
			var currLessons2=[];
			var oldlessons = [];
			//var newLessReport = {};
			
			//console.log("eCourseX.lessReport is " + JSON.stringify(eCourseX.lessReport));
			//console.log("ecoursex.lessreport length is " + lessReportkeys.length + " and lessonTitles length is " + lessonTitles.length);
			for(a=0;a<lessonTitles.length;a++){
				currLessons2.push(lessonTitles[a][0].slice(-2));
			}
			for(b=0;b<lessReportkeys.length;b++){
				oldlessons.push(eCourseX.lessReport[b]['num']);
			}
			var addlessons = 0;
			for(i=0;i<currLessons2.length;i++){
				
				
				if(oldlessons.includes(currLessons2[i])){
					//console.log("lesson " + currLessons2[i] + " should already be included");
				}
				else{
					//console.log("adding " + currLessons2[i] + " to newlessReport")
					var newkey = lessReportkeys.length+addlessons;
					eCourseX.lessReport[newkey] = {"num":currLessons2[i], "start":0, "complete":0, "view":0,"access":0};
					addlessons ++;
				}
				
				//eCourseX.lessReport[i] = {"num":shortless, "start":"", "complete":"", "view":"","access":0};                                   
			}
			//console.log("eCourseX.newLessREport is now " + JSON.stringify(newLessReport))
			//eCourseX.lessReport = newLessReport;
			//console.log("eCourseX.lessReport is now " + JSON.stringify(eCourseX.lessReport));
		 	if(eCourseX.lessReport[0]['start'] == "undefined" ||eCourseX.lessReport[0]['start'] == ""||eCourseX.lessReport[0]['start'] == null ||eCourseX.lessReport[0]['start'] == 0) eCourseX.lessReport[0]['start']= Date.now();
			 eCourseX.lessReport[0]['view'] = Date.now();
		}

		//create allreqdmovies
		//console.log("about to create allreqdmovies" + lessonTitles.length);
		for(a=0;a<lessonTitles.length;a++){
			var isopt = false;
			for(b=0;b<optkeywords.length;b++){
				if(lessonTitles[a][1].indexOf(optkeywords[b])>-1){
					//optional keyword found
					isopt = true;
					break;
				}
			}
			//if it's not an optional lesson
			if(!isopt){
				//get the lessonnum == ex. 01
			//	console.log("adding a lesson to allreqd");
				var lesscode = lessonTitles[a][0].substr(eCode.length);
				allreqdmovies[lesscode]=[];
				for(c=0;c<eval("sectionArray"+lesscode).length;c++){
					var sectcode = eval("sectionArray"+lesscode)[c][0];
					//console.log("sectcode is " + sectcode);
					for(d=0;d<optkeywords.length;d++){
						//console.log("optkeyword is " + optkeywords[d]);
						if(eval("sectionArray"+lesscode)[c][1].indexOf(optkeywords[d])>-1){
							isopt = true;
							break;
						}
					}
					//now you have a good, non-optional section-- add those moves to allreqdmovies array
					if(!isopt){
						for(e=0;e<eval("movieArray"+lesscode).length;e++){
						//	console.log("testing "+eval("movieArray"+lesscode)[e][0].indexOf(sectcode));
							if(eval("movieArray"+lesscode)[e][0].indexOf(sectcode)==0){
								for(f=0;f<optkeywords.length;f++){
									if(eval("movieArray"+lesscode)[e][2].indexOf(optkeywords[f])>-1){
										isopt = true;
										break;
									}
								}
								if(!isopt){
									var movcode = eval("movieArray"+lesscode)[e][0].substring(eCode.length);
									allreqdmovies[lesscode].push(movcode);
									reqdMovsTotal++;
						//			console.log("adding "+movcode+ " to allreqdmovs for " + lesscode);
									//console.log("reqdMovsTotal is now " + reqdMovsTotal);
								}
								else isopt = false;
								
							}
						}
						
					}
					else{
						isopt = false;
					}
					
				}
			}
			
		}//end create allreqdmovies
	

		//check moviesComplete to see if anything has been removed that is now in moviesComplete, if so remove it
		for(x=0;x<eCourseX.movieComplete.length;x++){
			var fullmov = eCodeLC+eCourseX.movieComplete[x];
			var lesscode = eCourseX.movieComplete[x].substr(0,2);
			var isgood = false;
			for(y=0;y<eval("movieArray"+lesscode).length;y++){
				if(eval("movieArray"+lesscode)[0] == fullmov){
					isgood = true;
					break;
				}
			}
			if(!isgood){
				eCourseX.movieComplete.slice(x);
			}
			
		}

		//now check to see if what's in moviecomplete make any lesson complete

		//go thru allreqdmovies, for each lesson, check to see if everything in it is also in movieComplete. if yes, call marklessoncomplete and then clear those from movieComplete.
		//allreqdmovies is key/value instead of indexed-- so need to use foreach as kay->value but that's php
		Object.keys(allreqdmovies).forEach(key => {
			// Perform operations with key and object[key]
			var alldone = true;
			for(a=0;a<allreqdmovies[key].length;a++){
				if(!eCourseX.movieComplete.includes(allreqdmovies[key][a])){
					alldone = false;
					break;
				}	
			}
			if(alldone){
				//console.log("calling marklessoncomplete from 877");
				markLessonComplete(key);
			}
		  });
		
	
        
		

		if(typeof eCourseX.survey == "undefined" && useSurvey){eCourseX.survey = false;}
		else if(!useSurvey){eCourseX.survey = true;}
		if(typeof eCourseX.transurvey == "undefined"){eCourseX.transurvey = [true,''];}
		if(myLangCode!="en" && eCode=="EVYOV51" && window.location.href.indexOf("testarea")==-1){
			const currentDate = new Date();
			const tstime = currentDate.getTime();
			$("#transdialog").dialog("open");
			//need to compare eCourseX.timestamp to eCourseX.transurvey[1]-- if within 24 hours, do nothing otherwise, pop trans alert
			if(eCourseX.transurvey[0] && eCourseX.transurvey[1]==''){
				$("#transdialog").dialog("open");
				//set transurvey[1] to tstime
				eCourseX.transurvey[1] = tstime;
			}
			else if(eCourseX.transurvey[0] && eCourseX.transurvey[1]!=''){
				const ONE_DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000; // 24 hours * 60 minutes * 60 seconds * 1000 milliseconds
  
  				// Calculate the absolute difference between the two timestamps
  				  const timeDifference = Math.abs(eCourseX.transurvey[1] - eCourseX.timestamp);

				  // Check if the difference is less than or equal to one day
				  if(timeDifference > ONE_DAY_IN_MILLISECONDS && eCourseX.transurvey[0]){
					//open the transurvey alert
					$("#transdialog").dialog("open");
					//set transurvey[1] to tstime
					eCourseX.transurvey[1] = tstime;
				  }
				  else {console.log("No transurvey popped -- inner loop.");}
					//	 && (eCourseX.transurvey[1] - eCourseX.timestamp))
			
			}
			else {console.log("No transurvey popped -- outer loop.");}
		}
		if(typeof eCourseX.coursestart == "undefined"){eCourseX.coursestart = 0;}
		if(typeof eCourseX.coursecomplete == "undefined"){eCourseX.coursecomplete = 0;}
	    if(eCourseX.autoadvance == "ON") setAutoadvance();
		if(eCourseX.autoplay == "OFF" || (eCourseX.autoplay=="ON" && mySCO == "88")) setAutoplay();
		if(eCourseX.countdown == "OFF") setVideoCountdown();
		if(eCourseX.textonly == "ON") goText("frominit");
		if(eCourseX.myfontsize !="100"){
			if(eCourseX.myfontsize == "125") {
				document.body.style.fontSize = "125%";	
				$(".faveDiv").css("padding-top",".2em");
				$("#panel1").css("margin-top","28px") 
			}
			else if(eCourseX.myfontsize == "150"){
				document.body.style.fontSize = "150%";
				$(".faveDiv").css("padding-top",".4em");
				$("#printVersion").css("padding-top","6px");
				$("#help").css("margin-top","4px");
				$("#panel1").css("margin-top","33px");
				$(".panel").css("height","91%");
			} 
		}
		if(eCourseX.cprog !="0"  && myLangCode=="en") document.getElementById("surveyButton").style.display="inline"; 
		else if(myLangCode != "en" && eCode=="EVYOV51") document.getElementById("transsurveyButton").style.display = "inline";
		//if reqLessonsComplete has not been set before
		var firstReq = Object.keys(eCourseX.reqLessonsComplete)[0];
		//for(i=0;i<eCourseX.reqLessonsComplete.length;i++){
		//	console.log("a req lesson is " + eCourseX.reqLessonsComplete[i][0]);
		//}
		//console.log("firstreq is " + firstReq);
		if(typeof firstReq =="undefined"){
			
			//console.log("initializing reqLessonsComplete from rc.js");
			//need to set up reqLessonComplete-- based on courseCheck -- 
			
			//if it's all, then set to same as lessonTitles with exceptions
			if (courseCheck == "all" && !testarea) {
				for(i=0;i<lessonTitles.length;i++){
					var nokeyword = true;
					//if it's the last lesson of the course, check if the title has one of the opt lesson titles in it
					//and for any lesson, check if it has one of the optional keywords in it
					if(i==lessonTitles.length-1){
						for(j=0;j<optlesstitles.length;j++){
							if(lessonTitles[i][1].indexOf(optlesstitles[j])>-1){
								nokeyword = false;
								unreqlessons += lessonTitles[i][0].slice(-2) + "@";
							} 
						}
					}
					for(j=0;j<optkeywords.length;j++){
						if(lessonTitles[i][1].indexOf(optkeywords[j])>-1) {
							nokeyword = false;
							unreqlessons += lessonTitles[i][0].slice(-2) + "@";
						}
					}
					if(nokeyword ){
						var mynum = lessonTitles[i][0].slice(-2);
						eCourseX.reqLessonsComplete[mynum] =  "no";
					}
				}
			}
			//otherwise, need to use reqLessons
			else{
				for(i=0;i<reqLessons.length;i++){
					eCourseX.reqLessonsComplete[reqLessons[i]] = "no";
					
				}
				if(reqLessons.length != lessonTitles.length){
					for(j=0;j<lessonTitles.length;j++){
						if(reqLessons.includes(lessonTitles[j][0].slice(-2))) {}// do nothing
						else unreqlessons += lessonTitles[j][0].slice(-2);
					}
				}
			}		
		}
		
		//if reqTopicsComplete has not been set and is required
		if(lessonCheck == "reqTopics"  && eCourseX.reqTopicsComplete == [] ){
			for(i=0;i<reqTopics.length;i++){
				eCourseX.reqTopicsComplete[i] = [reqTopics[i], "no"];
			}
		}
		if(lessonCheck == "viewAll"){
			//go through each lesson that isn't lesson 00
			//need to pull lesson numbers from lessonTitles[i].substring(-2)
			for(i=1;i<lessonTitles.length-1;i++){
				var myix = lessonTitles[i][0].slice(-2);
				//if(i<10) var ix = "0" + i;
				//else var ix = i;
				for(j=0;j<(eval("movieArray"+myix)).length;j++){
					if((eval("movieArray"+myix)[j][2].indexOf(quizlabel)>-1 && eval("movieArray"+myix)[j][2].length == quizlabel.length)|| (eval("movieArray"+myix)[j][2].indexOf(casestudylabel)>-1 && eval("movieArray"+myix)[j][2].length == casestudylabel.length)){
						hasquiz.push(myix);
					}
				}
			}
		}
		
		var allLess = [];
		for(aj=0;aj<lessonTitles.length;aj++){
			allLess[aj] = lessonTitles[aj][0].slice(-2);
		}
		//console.log("lessoncomplete length is " + eCourseX.lessonComplete.length);
		eCourseX.lessonComplete = eCourseX.lessonComplete.filter(function(value){
			return (allLess.includes(value));
		});
	//	console.log("and now lessoncomplete length is " + eCourseX.lessonComplete.length);
		for(j=0;j<eCourseX.lessonComplete.length;j++){
			//if the lesson is complete, increase coursemoviescomplete by the length of movieArrayXX.
			var myMovs = "movieArray"+eCourseX.lessonComplete[j];
			
			//console.log("completed movie array has length " + eval(myMovs).length);
			//if(allLess.includes(eCourseX.lessonComplete[j])){
				courseMoviesComplete += eval(myMovs).length;
				var reqkeys = Object.keys(allreqdmovies);
				
				for(k=0;k<eval(myMovs).length;k++){
					//console.log("LINE 1062" + eval(myMovs)[k][0].substring(eCode.length));
					if(reqkeys.includes(eval(myMovs)[k][0].substring(eCode.length,eCode.length+2))){
						if(allreqdmovies[eval(myMovs)[k][0].substring(eCode.length,eCode.length+2)].includes(eval(myMovs)[k][0].substring(eCode.length))) {
							courseReqMoviesComplete++ ;
						}
					}
				}
			//}
			//else{
			//	eCourseX.lessonComplete.splice(j,1);
			//}
			
			//console.log("coursemoviescomplete is now " + courseMoviesComplete );
			eCourseX.movieComplete  = eCourseX.movieComplete.filter(function(value){
				return value.substring(0,2)!=eCourseX.lessonComplete[j];
			});

		}
		
		for(l=0;l<eCourseX.movieComplete.length;l++){
			//console.log("testing for " + eCourseX.movieComplete[l]);
			var thismovcomplete = eCourseX.movieComplete[l].substring(0,2);
			//console.log("thismov is " + thismovcomplete);
			var reqkeys = Object.keys(allreqdmovies);
			if(reqkeys.includes(thismovcomplete)){
				if(allreqdmovies[thismovcomplete].includes(eCourseX.movieComplete[l])) {
					courseReqMoviesComplete++;
				}
			} 
		}
		//console.log("eCourseX movieComplete is now " + eCourseX.movieComplete);
		var firstStart = Date.now();
		
		for(key in eCourseX.lessReport){
			for(innerkey in eCourseX.lessReport[key]){
				//console.log('this is entry ' + innerkey + ': ' + eCourseX.lessReport[key][innerkey] + ' and it is type '+ typeof eCourseX.lessReport[key][innerkey]);
				switch (innerkey){
					case 'start':
						if(typeof eCourseX.lessReport[key][innerkey] == 'string' && eCourseX.lessReport[key][innerkey].indexOf("Z")>0){
							var newstart = Date.parse(eCourseX.lessReport[key][innerkey]);
							eCourseX.lessReport[key][innerkey] = newstart;
							if(newstart < firstStart) {
								firstStart = newstart;
								console.log("changing firstStart to " + firstStart);
							}
						}
						else if(eCourseX.lessReport[key][innerkey] == null){
							eCourseX.lessReport[key][innerkey] = 0;
						}
					case 'view':
						if(typeof eCourseX.lessReport[key][innerkey] == 'string'&& eCourseX.lessReport[key][innerkey].indexOf("Z")>0){
							var newview = Date.parse(eCourseX.lessReport[key][innerkey]);
							if(typeof newview =="number") eCourseX.lessReport[key][innerkey] = newview;
						}
						else if(eCourseX.lessReport[key][innerkey] == null){
							eCourseX.lessReport[key][innerkey] = 0;
						}
					case 'complete':
						if(typeof eCourseX.lessReport[key][innerkey] == 'string'&& eCourseX.lessReport[key][innerkey].indexOf("Z")>0){
							var newcomplete = Date.parse(eCourseX.lessReport[key][innerkey]);
							if(typeof newcomplete == "number") eCourseX.lessReport[key][innerkey] = newcomplete;
						}
						else if(eCourseX.lessReport[key][innerkey] == null){
							eCourseX.lessReport[key][innerkey] = 0;
						}
				}
			}
			
		}
		//console.log("courseReqMoviesComplete is " + courseReqMoviesComplete);
		//console.log("and reqdMovsTotal is " + reqdMovsTotal);
		eCourseX.cprog = (courseReqMoviesComplete/reqdMovsTotal)*100;
		//console.log("cprog before rounding is " + eCourseX.cprog);
		eCourseX.cprog = Math.round(eCourseX.cprog);
		if(eCourseX.cprog > 100) eCourseX.cprog  = 100;
		//console.log("courseprog is " + eCourseX.cprog + " and type is " + typeof eCourseX.cprog);
		if(firstStart < Date.now()){
			eCourseX.coursestart = firstStart;
		//	sendXAPIstatement(xstarted,window.location.href +"/"+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum + "/on/"+firstStart);
		}
		if(eCourseX.lessReport=={}){
			for(i=0;i<lessonTitles.length;i++){
				var shortless = lessonTitles[i][0].slice(-2);
				//console.log("shortless is " + shortless);
				eCourseX.lessReport[i] = {"num":shortless, "start":0, "complete":0, "view":0,"access":0};                                   
			}
		 	eCourseX.lessReport[0]['start']= Date.now();
			 eCourseX.lessReport[0]['view'] = Date.now();
		}
	if(eCourseX.lessReport[0]['start']=="" || eCourseX.lessReport[0]['start']==null|| eCourseX.lessReport[0]['start']==0)eCourseX.lessReport[0]['start']= Date.now();
		if(eCourseX.lessReport[0]['view']=="" || eCourseX.lessReport[0]['view']==null|| eCourseX.lessReport[0]['view']==0)eCourseX.lessReport[0]['view'] = Date.now();  
		
			//console.log("here 729");
		if(eCourseX.lessReport[0]['access']==null || eCourseX.lessReport[0]['access']==0)eCourseX.lessReport[0]['access']=1;                                                                                        
		//for(i=0;i<eCourseX.lessReport.length;i++){                                                                                                                        
		//	console.log("testing eCoursex.lessReport");                                     
		//	console.log(eCourseX.lessReport[i]);
		//}
		//console.log("eCourseX.lessReport is now " + eCourseX.lessReport[0]['start']);

		//check for nonstandard quiz label
		if(typeof newQuizlabel != "undefined" && newQuizlabel.length>1){
			quizlabel = newQuizlabel;
		}

        allset = "yes";
        resolve(allset);
    });
}

function finalLoad(){
    writeCourseTOC();
	setTimeout(setChecks(),1000);
	setTimeout(checkResume(),2000);
		//GUI changes		  
	if(SCORMcourse){
		$("#takeNote").remove();
