	$("#transdialog").dialog("close");
}					   

function openSurvey(whichsurvey){
	if(whichsurvey=="en") openOther('survey.htm');
	else if(whichsurvey=="trans") openOtherWide('transurvey.htm');
}

function runTestQuery(){
	$.ajax({
			type: "POST",
			url:xAPIgetURL,	
			xhrFields : {
				withCredentials : true
			},
			data:{
			
				"verb":xinteracted.verb,
				"verbDisplay": xinteracted.verbDisplay
			},
			success:function(data){
				console.log("here it is "+ data);
			},
			error:function(){
				console.log("no good.");
			}
	});
}

//not called from transcript popup window-- function is duplicated in that page's header
function loadUserNoteMain(){

	//console.log("trying to load user note");
	var mypageIRI = window.location.href.substring(0,window.location.href.indexOf(".com/"))+ ".com/"+ eCode + "/" + myLessonX + "/" + myObjectID;
	for(i=0;i<eCourseX.mynotes.length;i++){
		var fullName = eCodeLC + eCourseX.mynotes[i];
		ajaxstring=mypageIRI+'&*'+actor2.account.name+'/'+fakeid;
		if(fullName == myObjectID){
			
			$.ajax({
				type: "POST",
				url:xAPIgetURL,	
				xhrFields : {
					withCredentials : true
				},
				data:{
					//"actorAccount":actor2.account.homePage,
//					"actorName":actor2.account.name,
//					"activityPath": mypageIRI
'mydata':ajaxstring
				},
				crossDomain : true,
				success: function(data){
					console.log("note data " + data);
					myExistingNote = data.replace(/\n/g, "<br />");
					
					$('#actualNote').html("<p>" + myExistingNote + "</p>");
					document.getElementById('notesSection').style.display='block';
				},
				error:function(){
					console.log("problem getting note");
				}
			});
			break;
			
		}
	}	
	
	
} 
