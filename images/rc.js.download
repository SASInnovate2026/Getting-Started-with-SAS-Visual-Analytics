var swapopt = "default";
function swapSteps(){
 if(swapopt=="default"){
	$('.optone').show();
	$('.defaultopt').hide();
	$('#swapper').onclick = "javascript:swapSteps('defaultopt');";
	document.getElementById('swapper').innerHTML = "Show " +  swapOpts[0];
	swapopt = 'optone';
 }
 else if(swapopt=='optone'){
	$('.optone').hide();
	$('.defaultopt').show();
	$('#swapper').onclick = "javascript:swapSteps('optone');";
	document.getElementById('swapper').innerHTML = "Show " + swapOpts[1];
	swapopt='default';
 }
}

/// function for RC exercise

function showSolutionInSteps(fromPrint) {
	
	if(fromPrint){
		if(fromPrint=="show"){
		
			var myOtherBUttons = document.getElementsByClassName("solnB");
			
			for(i=0;i<myOtherBUttons.length;i++){
				$(myOtherBUttons[i]).html(hsbtn);
				$(myOtherBUttons[i]).attr('aria-label','Hide solution within numbered steps');
			}
			$('.soln').css('display','block');
		}
			
		else if(fromPrint=="hide"){
	
			var myOtherBUttons = document.getElementsByClassName("solnB");
			
				for(i=0;i<myOtherBUttons.length;i++){
					$(myOtherBUttons[i]).html(ssbtn);
					$(myOtherBUttons[i]).attr('aria-label','Show solution within numbered steps');
				}
				$('.soln').css('display','none');
			}
		else{
			var mybuttonid = '#solnButton'+fromPrint;
			var mycurrID = $(mybuttonid).closest('div .forPrint2').attr('id');
			
			var mysolns = document.getElementById(mycurrID).querySelectorAll('.soln');
			//console.log("mysolns is " + mysolns.length);
			for(i=0;i<mysolns.length;i++){
				if($(mysolns[i]).css('display') != "block") $(mysolns[i]).css('display','block');
				else $(mysolns[i]).css('display','none');
			}
			if ($(mybuttonid).html() != hsbtn){
				
				$(mybuttonid).html(hsbtn);
				$(mybuttonid).attr('aria-label','Hide solution within numbered steps');
				
			}
			else {
				
				$(mybuttonid).html(ssbtn);
				$(mybuttonid).attr('aria-label','Show solution within numbered steps');
			}
		}
		
	}
	else{
		if ($('.soln').css('display') != "block"){
			/*! if solution is hidden, open it and change gif */
			$('.soln').css('display','block');
			$('#solnButton').html(hsbtn);
			$('#solnButton').attr('aria-label','Hide solution within numbered steps');
			sendXAPIstatement(xinteracted,window.location.href +'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/solution/"+myObjectID);	
		}
		else {
			/*! otherwise hide solution and change gif */
			$('.soln').css('display','none');
			$('#solnButton').html(ssbtn);
			$('#solnButton').attr('aria-label','Show solution within numbered steps');
		}
	}
	
}


function showSolutionOnPage(myClass) {
	$('.'+myClass).each(function () {
		if ($(this).css('display') != "block"){
			/*! if solution is hidden, open it and change gif */
			$(this).css('display','block');
			if (myClass == 'soln-1') $('#firstButton').html(hsbtn);
			if (myClass == 'soln-2') $('#secondButton').html(hsbtn);
			if (myClass == 'soln-3') $('#thirdButton').html(hsbtn);
			sendXAPIstatement(xinteracted,window.location.href +'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/solution/"+myObjectID);
		
		} 
		else {
			/*! otherwise hide solution and change gif */
			$(this).css('display','none');
			if (myClass == 'soln-1') $('#firstButton').html(ssbtn);
			if (myClass == 'soln-2') $('#secondButton').html(ssbtn);
			if (myClass == 'soln-3') $('#thirdButton').html(ssbtn);
		}
	});
}

function showQuizStepsOnPage(whichSteps) {  
   $('.Qstep'+whichSteps).each(function () {
      	if ($(this).css('display') != "block"){
			/*! if solution is hidden, open it and change gif */
			$(this).css('display','block');
			$('#show'+whichSteps).html("Hide Steps");
			sendXAPIstatement(xinteracted,window.location.href +'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/quizSteps/"+myObjectID);
      	} 
		else {
			/*! otherwise hide solution and change gif */
			$(this).css('display','none');
			$('#show'+whichSteps).html("Show Steps");	
		}
	});
}		


function checkMyAnswer() {
	$("#NoAnswer, #Correct, #Incorrect").hide();
	$("#NoAnswer, #Correct, #Incorrect").attr("tabindex","-1");
	var isCorrect = 0;
	var myAnswer = "";
	for (i = 0; i < document.getElementsByName('ques1').length; i++) {
		if (document.getElementsByName('ques1')[i].checked) {
			myAnswer = document.getElementsByName('ques1')[i].value;
			myAnswer = myAnswer.toLowerCase();
			if (myAnswer == CorrAns) {
				$("#Correct").show();
				$("#Correct").focus();
				isCorrect = 1;
			} 
			else {
				$("#Incorrect").show();
				$("#Incorrect").focus();
			}
		}
	}
	if (myAnswer === "") {
		$("#NoAnswer").show();
		$("#NoAnswer").focus();
	}
	sendXAPIstatement(xanswered,window.location.href +'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+myLessonX +"/" + myObjectID + "/" + myAnswer,isCorrect);
}

function checkMyAnswerSA(form) {
	$("#NoAnswer, #Correct, #Incorrect").hide();
	$("#NoAnswer, #Correct, #Incorrect").attr("tabindex","-1");
	var isCorrect = 0
	var myAnswer = "";
	for (var i = 0; i < document.getElementsByName('ques1').length; i++) {
		if (document.getElementsByName('ques1')[i].checked) {
			myAnswer += document.getElementsByName('ques1')[i].value + " ";
		}
	}
	myAnswerString = myAnswer.replace(/\s/g, '');
	if (myAnswerString == CorrAns) {
		$("#Correct").show();
		$("#Correct").focus();
		isCorrect = 1;
	} 
	else if ((myAnswerString != CorrAns) && (myAnswerString != "")) {
		$("#Incorrect").show();
		$("#Incorrect").focus();
	} 
	else {
		$("#NoAnswer").show();
		$("#NoAnswer").focus();
	}
	sendXAPIstatement(xanswered,window.location.href +'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+myLessonX +"/" + myObjectID + "/" + myAnswer,isCorrect);
}

function checkMyAnswerMatch(form) {
	$("#NoAnswer, #Correct, #Incorrect").hide();
	$("#NoAnswer, #Correct, #Incorrect").attr("tabindex","-1");
	var isCorrect = 0
	var myAnswer = "";
	
	$("input[type='text']").each(function () {
		myAnswer = myAnswer + " " + $(this).val();
	});
	
	myAnswerString = (myAnswer.replace(/\s/g, '')).toLowerCase();
	if (myAnswerString == CorrAns) {
		$("#Correct").show();
		$("#Correct").focus();
		isCorrect = 1;
	} 
	else if ((myAnswerString != CorrAns) && (myAnswerString != "")) {
		$("#Incorrect").show();
		$("#Incorrect").focus();
	} 
	else {
		$("#NoAnswer").show();
		$("#NoAnswer").focus();
	}	
	sendXAPIstatement(xanswered,window.location.href +'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+myLessonX +"/" + myObjectID + "/" + myAnswer,isCorrect);
}

