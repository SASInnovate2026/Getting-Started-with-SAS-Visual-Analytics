function cancelNote(){
	makeNewNote = false;
	if(window.location.href.indexOf("rc_common")>-1){
		$("input:text").val("");
		$('#noteEntry').css('display','none');
		window.opener.makeNewNote = false;
	}
	else{
		$("input:text").val("");
		$('#noteEntry').css('display','none');
		if(transWindow && !transWindow.closed){
			$("input:text", transWindow.document).val("");
			$('#noteEntry',transWindow.document).css('display','none');
		} 
	
	}
}

var editFlag=false;
function editNote(){
	editFlag=true;
	
	$("textarea").val(myExistingNote.replace(/<br\s*[\/]?>/gi, "\n"));
	 
	document.getElementById('noteEntry').style.display='block';
	document.getElementById('userNote').focus();
}

function showNoteBox(){
	//("trying to show note box");
	//check if note box is already open if you're in the transcript window
	if(window.location.href.indexOf("transcript")>0 || window.location.href.indexOf("printversion")>-1){
		if(document.getElementById('myNote').style.display=='block'){
			editNote();
		}
		else{
			document.getElementById('notesSection').style.display='block';
	
			document.getElementById('noteEntry').style.display='block';
			document.getElementById('myNote').style.display='none';
			document.getElementById('userNote').focus();	
		}
	}
	else{
		document.getElementById('notesSection').style.display='block';
	
		document.getElementById('noteEntry').style.display='block';
		document.getElementById('myNote').style.display='none';
		document.getElementById('userNote').focus();
	}
	//otherwise just 
	
}

function deleteNote(){
	if(window.location.href.indexOf("transcript")>0 || window.location.href.indexOf("printversion")>0){
		var myNotePageIRI = window.location.href.substring(0,window.location.href.indexOf(".com/"))+ ".com/"+ eCode + "/" + window.opener.myLessonX + "/" + window.opener.myObjectID;
		var shortName = window.opener.myObjectID.substring(window.opener.eCode.length);
        ajaxstring=myNotePageIRI+'&*'+window.opener.actor2.account.name+'/'+fakeid+'()';
		$.ajax({
			type:"POST",
			url: xAPIsetURL,
			xhrFields: { withCredentials:true},
			data:{
				//"actorAccount":window.opener.actor2.account.homePage,
			//	"actorName": window.opener.actor2.account.name,
			//	"activityPath":  myNotePageIRI,
            'mydata':ajaxstring
			//	"progressContent": ""
			},
			success: function(){
				console.log("note deleted. " );
					
				if(window.opener.eCourseX.mynotes.indexOf(shortName)>-1){
					var whichNote = window.opener.eCourseX.mynotes.indexOf(shortName);
					window.opener.eCourseX.mynotes.splice(whichNote,1);
				}
											
				window.opener.setLRSdata();
					
				document.getElementById('myNote').style.display='none';
				document.getElementById('noteEntry').style.display='none';
				window.opener.makeNewNote=false;
				window.opener.unsetNoteIcon();
				window.location.reload();
			},
			error: function(){
				console.log("an error has occurred. note was not deleted.");
			}
		});
	}
	else{
		var myNotePageIRI = window.location.href.substring(0,window.location.href.indexOf(".com/"))+ ".com/"+ eCode + "/" + myLessonX + "/" + myObjectID;
		var shortName = myObjectID.substring(eCode.length);
        ajaxstring=myNotePageIRI+'&*'+window.opener.actor2.account.name+'/'+fakeid+'()';
		$.ajax({
			type:"POST",
			url: xAPIsetURL,
			xhrFields: { withCredentials:true},
			data:{
				//"actorAccount":actor2.account.homePage,
				//"actorName": actor2.account.name,
				//"activityPath":  myNotePageIRI,
                'mydata':ajaxstring
				//"progressContent": ""
			},
			success: function(){
				console.log("note deleted. " );

				if(eCourseX.mynotes.indexOf(shortName)>-1){
					var whichNote = eCourseX.mynotes.indexOf(shortName);
					eCourseX.mynotes.splice(whichNote,1);
				}		

				setLRSdata();

				document.getElementById('myNote').style.display='none';
				document.getElementById('noteEntry').style.display='none';
				makeNewNote=false;
				unsetNoteIcon();
				//reload();
			},
			error: function(){
				console.log("an error has occurred. note was not deleted.");
			}
		});
	}
	
}

var myExistingNote="";
function showNote(mytext){
	
	myExistingNote = mytext.replace(/\n/g, "<br />");
	
	$('#actualNote').html("<p>" + myExistingNote  + "</p>");
	
		document.getElementById('notesSection').style.display='block';
		document.getElementById('myNote').style.display='block';
		document.getElementById('noteEntry').style.display='none';

}

function  stripHTML(text){
   	var regex = /(<([^>]+)>)/ig;
   	return text.replace(regex, "");
}

function sendNote(){
	if(window.location.href.indexOf("transcript")>0 || window.location.href.indexOf("printversion")>0){
		var shortName = window.opener.myObjectID.substring(window.opener.eCode.length);
		
		if(SCORMcourse){
			alert(notedisabled);
		}
		else{
			
			var myNote = $('#userNote').val();
			//myNote = stripHTML(myNote);

			//myNote = DOMPurify.sanitize(myNote);
			myNote = stripHTML(myNote);
			var myNotePageIRI = window.location.href.substring(0,window.location.href.indexOf(".com/"))+ ".com/"+ eCode + "/" + window.opener.myLessonX + "/" + window.opener.myObjectID;
			if(editFlag){
				var wholeNote = myNote;
			}
			else {
				var wholeNote = myExistingNote + '<br>' +  myNote;
			}
			var alreadyThere=false;
			sendXAPIstatement(xannotated,window.location.href  + "/"+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/"+window.opener.myLessonX + "/" + window.opener.myObjectID);
            ajaxstring=myNotePageIRI+'&*'+window.opener.actor2.account.name+'/'+window.opener.fakeid+'('+wholeNote+')';
	
			$.ajax({
				type:"POST",
				url: xAPIsetURL,
				xhrFields: { withCredentials:true},
				data:{
					//"actorAccount":window.opener.actor2.account.homePage,
					//"actorName": window.opener.actor2.account.name,
					//"activityPath":  myNotePageIRI,
                    'mydata':ajaxstring
				//	"progressContent": wholeNote
				},
				success: function(){
					if(window.opener.eCourseX.mynotes.indexOf(shortName)>-1){
						alreadyThere = true;
						console.log("not writing to mynotes");
					}
											
					else{
						window.opener.eCourseX.mynotes.push(shortName);
						window.opener.setNoteIcon();
					}
					window.opener.setLRSdata();
					window.opener.makeNewNote=false;
					window.location.reload();
					$("textarea").val('');
				},
				error: function(){
					console.log("an error has occurred. note was not saved.");
					alert(noteerror);
					window.location.reload();
				}
			});
			window.opener.makeNewNote=false;
			editFlag = false;
		}
	}
	else{

		var shortName = myObjectID.substring(eCode.length);
		if(SCORMcourse){
			alert(notedisabled);
		}
		else{
			var myNote = $('#userNote').val();
			//myNote = DOMPurify.sanitize(myNote);
			myNote = stripHTML(myNote);
			var myNotePageIRI = window.location.href.substring(0,window.location.href.indexOf(".com/"))+ ".com/"+ eCode + "/" + myLessonX + "/" + myObjectID;
			if(editFlag){
				var wholeNote = myNote;
			}
			else {
				var wholeNote = myExistingNote + '<br>' +  myNote;
			}
			var alreadyThere=false;
			sendXAPIstatement(xannotated,window.location.href  + "/"+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+  "/"+myLessonX + "/" + myObjectID);
		ajaxstring=myNotePageIRI+'&*'+actor2.account.name+'/'+fakeid+'('+wholeNote+')';
			$.ajax({
				type:"POST",
				url: xAPIsetURL,
				xhrFields: { withCredentials:true},
				data:{
				//	"actorAccount":actor2.account.homePage,
				//	"actorName": actor2.account.name,
				//	"activityPath":  myNotePageIRI,
                'mydata':ajaxstring
					//"progressContent": wholeNote
				},
				success: function(){
					if(eCourseX.mynotes.indexOf(shortName)>-1){
						alreadyThere = true;
						console.log("not writing to mynotes");
					}
											
					else{
						eCourseX.mynotes.push(shortName);
						setNoteIcon();
					}
					setLRSdata();
					makeNewNote=false;
					showNote(wholeNote);
					$("textarea").val('');
				},
				error: function(){
					console.log("an error has occurred. note was not saved.");
					alert(noteerror);
					//window.location.reload();
				}
			});
			makeNewNote=false;
			editFlag = false;
		}
	}
}

var detailshow = 1;
function hidedetail(){
	//console.log("in function and detailshow is " + detailshow);
