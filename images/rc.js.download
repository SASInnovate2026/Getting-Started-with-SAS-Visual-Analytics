/* load a note in the open transcript window for HTML items */
function loadNoTranscript() {
	
	if(transWindow && !transWindow.closed) {
		if (eCourseX.textonly == 'ON') {
			$('#content', transWindow.document).html('<p style="margin-left:20px;">' + videooffmsgpop + '</p>');
		}
		else {
			$('#content', transWindow.document).html('<p style="margin-left:20px;">' + notvideomsgpop + '</p>');
		}
		$('#takeNote2', transWindow.document).css('display','none');
		$('.pbtn', transWindow.document).css('display','none');
		$('.hider', transWindow.document).css('display','none');
		$('#notesSection', transWindow.document).css('display','none');
		$('#noteEntry', transWindow.document).css('display','none');
		transWindow.document.getElementById('takeNote2').disabled=true;
		transWindow.document.title = transtitle;
		transWindow.blur();
	}
}



