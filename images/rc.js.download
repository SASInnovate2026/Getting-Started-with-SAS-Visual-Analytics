//need to change this to read eCourseX.myfontsize

function setFontSize(whichway){
	
	//increasing
	console.log("increasing");
	if(eCourseX.myfontsize == "100" && whichway == "bigger") {
		document.body.style.fontSize = "125%";
		
		$(".faveDiv").css("padding-top",".2em");
		$("#panel1").css("margin-top","28px") 
		eCourseX.myfontsize = "125";
	}
	else if(eCourseX.myfontsize == "125" && whichway == "bigger"){
		document.body.style.fontSize = "150%";
		
	    $(".faveDiv").css("padding-top",".4em");
		$("#printVersion").css("padding-top","6px");
		$("#help").css("margin-top","4px");
		$("#panel1").css("margin-top","33px");
		$(".panel").css("height","91%");
	//	$(".popout").css("background-size",".8em");
		eCourseX.myfontsize = "150";
	} 
	//decreasing
	else if(eCourseX.myfontsize == "150" && whichway == "smaller") {
		document.body.style.fontSize = "125%";
		
		$(".faveDiv").css("padding-top",".2em");
		$("#panel1").css("margin-top","28px");
	//	$(".popout").attr("style","");
		eCourseX.myfontsize = "125";
	}
	else if(eCourseX.myfontsize == "125" && whichway == "smaller"){
		document.body.style.fontSize = "100%";
		
	  	$(".faveDiv").attr("style","");
		$("#printVersion").attr("style","");
		$("#help").attr("style","");
		$("#panel1").attr("style","");	
		$(".panel").attr("style","");
		eCourseX.myfontsize = "100";
	} 
	setLRSdata();
}


function toggleAns(mytogid){
	console.log(mytogid);
  	var tbtn =(mytogid).substr(12); 
	console.log("tbtn is " + tbtn);
	var mytogans = "q" + tbtn + "a";
	if ($("#"+mytogans).is(':visible')) {	 
		$("#"+mytogid).val(sabtn) 
		$("#"+mytogid).attr('aria-label','Show Answer');
		
		$("#"+mytogans).hide();	
	} else {	
		$("#"+mytogid).val(habtn); 	
		$("#"+mytogid).attr('aria-label','Hide Answer');
		
		$("#"+mytogans).show();	
	}    
	 
}
function toggleAllAns(which){
	
	var allAns = document.getElementsByClassName('answer');
	var allQbutns = document.getElementsByClassName('togg');

	if(which == "show"){
		for(i=0;i<allAns.length;i++){
			$("#"+allAns[i].id).show();
		}
		for(j=0;j<allQbutns.length;j++){
			$("#"+allQbutns[j].id).val(habtn) 
			$("#"+allQbutns[j].id).attr('aria-label','Hide Answer');
		}
		document.getElementById('bigToggbtn').innerText = "Hide All Answers and Solutions";
		$('#bigToggbtn').attr('onclick','toggleAllAns("hide");');
		showSolutionInSteps(which);
		showSolutionOnPage(which);
	}
	else{
		for(i=0;i<allAns.length;i++){
			$("#"+allAns[i].id).hide();
		}
		for(j=0;j<allQbutns.length;j++){
			$("#"+allQbutns[j].id).val(sabtn) 
			$("#"+allQbutns[j].id).attr('aria-label','Show Answer');
		}
		document.getElementById('bigToggbtn').innerText = "Show All Answers and Solutions";
		$('#bigToggbtn').attr('onclick','toggleAllAns("show");');
		showSolutionInSteps(which);
		showSolutionOnPage(which);
	}
}

function goDark(){
	var lightOrDark = eCourseX.mymode;
	
	//console.log(lightOrDark);
	if(lightOrDark == "light"){
		document.getElementById("maincss").href="dlc_dark.css";
		lightOrDark = "dark";
		document.getElementById("accDark").innerText = dkbtnoff;
		$("<span aria-hidden='true'> (Alt+Z)</span>").appendTo($('#accDark'));
		eCourseX.mymode = "dark";
	}
	else if(lightOrDark == "dark"){
		document.getElementById("maincss").href="dlc.css";
		lightOrDark = "light";
		document.getElementById("accDark").innerText = dkbtn;
		$("<span aria-hidden='true'> (Alt+Z)</span>").appendTo($('#accDark'));
		eCourseX.mymode = "light";
	}
	setLRSdata();
	sendXAPIstatement(xinteracted, window.location.href+'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum  + '/setMode/'+ lightOrDark);
	setTimeout(function(){window.scrollTo(0,0);console.log("scrolling");},2000);
}

function openAccessTips(){
	var myurlbase = window.location.href.substring(0,window.location.href.lastIndexOf("/"));
	myTipsURL = myurlbase + '/rc_common/accessTips_' + myLangCode +  '.htm'
	if(myLangCode == "en"){
		openOther('rc_common/accessTips.htm');
	}
	else{
		$.ajax({
			url: myTipsURL ,
			error: function(){
				console.log("ajax problems");
				openOther('rc_common/accessTips.htm');
			},
			success: function(){
				openOther('rc_common/accessTips_' + myLangCode +  '.htm');
			}
     	});  
	}
}

/*!
 ******************************
 * landmark stuff
 ******************************/

function hidePopUpDivs() {
	$('.landmarkDiv').hide();
}


function openLandmarks(){
	$('.landmarkDiv').show();
		$('#landmarkDivFirstItem').focus();
		$(document).keyup(escToExitLandmark);
		$(document).keyup(tabToJailLandmark);
		$(document).keydown(detectLastItem);
}



/*
 * showFancyPopUp(x:Object,z:Object,x:Number,y:Number,d:String)
 *
 * displays fancy popups
 *
 * x = object's position
 * z = object's offset
 * w = object's width
 * y = object's height
 * d = the id/class of the hidden div
 */
function showFancyPopUp(t, d) {
	hidePopUpDivs();
	$('.' + d).toggle();
	$("#" + d).css('bottom', 65);
	$("#fancyDivArrow").css('bottom', 60);
	$("#" + d).css('right', (t - ($("#" + d).width() / 2)));
	$("#fancyDivArrow").css('right', (t - ($("#fancyDivArrow").width() / 2)));
	$(document).keyup(escToExitFancyPopups);
	$('#' + d + 'FirstItem').focus();
	$(document).keydown(detectLastItem);
	$(document).keyup(tabToJailFancyPopups);
}


var isCtrl = false;
$(document).on('keyup', function (e) {
	if (e.which == 17)
		isCtrl = false;
}).keydown(function (e) {
	if (e.which == 17)
		isCtrl = true;
	if (e.which == 117 && isCtrl == true) {
		e.preventDefault();
		$('.landmarkDiv').show();
		$('#landmarkDivFirstItem').focus();
		$(document).keyup(escToExitLandmark);
		$(document).keyup(tabToJailLandmark);
		$(document).keydown(detectLastItem);
		isCtrl = false;
		return false;
	}
});

function escToExitLandmark(e) {
	if (e.keyCode == 27) {
		$('.landmarkDiv').hide();
		$(document).unbind("keyup", escToExitLandmark);
		$(document).unbind("keyup", tabToJailLandmark);
		$(document).unbind("keydown", detectLastItem);
		lastItem = '';
	}
}

function tabToJailLandmark(e) {
	if (e.keyCode == 9) {
		//console.log('goToLast:'+goToLast+' goToFirst:'+goToFirst+' e.target.id:'+e.target.id+' lastItem:'+lastItem+$(document.activeElement).id);
		if (goToDelete) {
			$('#landmarkDeleteButton').focus();
			goToDelete = false;
		} 
		else if (goToLast) {
			$('#landmarkDivLastItem').focus();
			goToLast = false;
		} 
		else if (goToFirst) {
			$('#landmarkDivFirstItem').focus();
			goToFirst = false;
		} 
		else if ((e.target.id == "landmarkDeleteButton") && (lastItem == 'landmarkDivFirstItem')) {
			$('#landmarkDeleteButton').focus();
			goToLast = true;
			//console.log('goToLast'+goToLast);
		} 
		else if ((lastItem == 'landmarkDeleteButton') && (e.target.id != 'landmarkDivFirstItem')) {
			$('#landmarkDivLastItem').focus();
		} 
		else {
			if ((lastItem == 'landmarkDivLastItem') && (e.target.id != 'landmarkDiv2')) {
				$('#landmarkDeleteButton').focus();
				//goToFirst = true;
			}
		}
	}
}

function detectLastItem(e) {
	lastItem = e.target.id;
	//console.log(e.target.id);
}

function landmarkToContents(){
    $('#tab1').click();	
	$('#panel1').focus();
	$('.playing button').focus();
}

function landmarkToSearch(){
    $('#tab3').click();	
	$('#searchtext2').focus();
}

 /************************************************************************************************
 * jQuery events
 ***********************************************************************************************/
$(document).on('click', "#tabs li[role='tab']", function(){
	$("li[role='tab']").attr("aria-selected","false"); //deselect all the tabs 
 	$(this).attr("aria-selected","true");  // select this tab
	var tabpanid= $(this).attr("aria-controls"); //find out what tab panel this tab controls  
    var tabpan = $("#"+tabpanid);  
	$("div[role='tabpanel']").attr("aria-hidden","true"); //hide all the panels 
	tabpan.attr("aria-hidden","false"); 
	if (tabpan[0].id == "panel1") tabpan.scrollTop(scroll_position1); //if panel1 is scrolled down, keep the position
	else tabpan.scrollTop(scroll_position2); 
 });

$(document).on('keydown', "li[role='tab']", function(ev){
 	if ((ev.which ==13)||(ev.which ==32)) {
		ev.preventDefault();
 		$(this).click()
 	}
 });

//This adds keyboard function that pressing an arrow left or arrow right from the tabs toggle the tabs. 
 $(document).on('keydown',"li[role='tab']", function(ev){
	if ((ev.which ==39)||(ev.which ==37)) { 
	 	var selected= $(this).attr("aria-selected"); 
  		if (selected =="true"){ 
    		$("li[aria-selected='false']").attr("aria-selected","true").focus() ; 
    		$(this).attr("aria-selected","false"); 
    		var tabpanid= $("li[aria-selected='true']").attr("aria-controls"); 
    		var tabpan = $("#"+tabpanid); 
    		$("div[role='tabpanel']").attr("aria-hidden","true"); 
    		tabpan.attr("aria-hidden","false");
   		}
 	}
});


 //keyboard combo to trigger debug window - 68 is "d" - ALT+CTRL+d
$(document).on('keydown',function(ev){
	if (ev.which === 68 && ev.altKey && ev.ctrlKey) {
		   openOther('debugDLC.htm');
		}
 });
// with contentContainer active, equal sign displays movie name in alert window
$(document).on('keydown',"#contentContainer",function(ev){
   if (ev.which === 187) {
