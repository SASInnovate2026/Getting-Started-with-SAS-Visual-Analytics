}

//here is the fail-quiz statement
function sendFailStatement(myObjectID, moduleShort, myScore){
	sendXAPIstatement(xfailed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/' + moduleShort + '/quiz/' + wrongAnswers,false,myScore);
}

function BasePageStoreQuizResult(myObjectID, moduleShort, myScore) {   
    if (jQuery.inArray(myObjectID, eCourseX.movieComplete) < 0) {
		var shortmov = myObjectID.substring(eCode.length);
		eCourseX.movieComplete.push(shortmov);
	} 

	 markLessonComplete(moduleShort, myScore);
	if(typeof wrongAnswers == 'undefined') wrongAnswers="*$*";
		sendXAPIstatement(xpassed,window.location.href  + '/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum+'/'+moduleShort + '/quiz/' + wrongAnswers,true,myScore);
	setLRSdata();
	setChecks();

}

