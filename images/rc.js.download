		}
		else if(myType == 'vid'){
			if(transWindow && !transWindow.closed){
				transWindow.showNoteBox();
				transWindow.focus();
			} 
			else {
				openTranscript("note");
			} 
		}
		/*else if(myType == 'html1'){
			if(newWindow && !newWindow.closed) setTimeout(function(){newWindow.focus();},100);
			else openPrintVersion(myMovieTitle);
		}
		else if(myType == 'html2'){
			if(newWindow && !newWindow.closed) setTimeout(function(){newWindow.focus();},100);
			else openPrintVersion2(myMovieTitle);
		}
		else if(myType == 'html3'){
			if(newWindow && !newWindow.closed) setTimeout(function(){newWindow.focus();},100);
			else openPrintVersionEmbed(myMovieTitle);
		}*/
		//makeNewNote=true;
	}
	
}



