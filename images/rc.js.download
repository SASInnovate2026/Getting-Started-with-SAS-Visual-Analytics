function checkForString(stringPrefix) {
	var stringPrefixEquals = stringPrefix + '='; // lessonComplete=, movieComplete=
	var myCookie = document.cookie;
	if (myCookie.length > 0) {
		begin = myCookie.indexOf(stringPrefixEquals);
		if (begin != -1) {
			begin += stringPrefixEquals.length;
			end = myCookie.indexOf(';', begin);
			if (end == -1)
				end = myCookie.length;
			return unescape(myCookie.substring(begin, end));
		}
	}
	return null;
}*/

//SCORM exit function
function Exit(){ 
    //  alert('You are exiting the lesson.');
	if (SCORMcourse){
		window.parent.CommitData();
		window.parent.SetNavigationRequest("continue");
		window.parent.ConcedeControl();
