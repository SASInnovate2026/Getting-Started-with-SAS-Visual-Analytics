}

//COURSE DATA SET/GET FUNCTIONS

/*!
 * createCoursexapiJSON()
 *
 * method to create the JSON with default values.
 *
 */

function createCoursexapiJSON(c) {
	//console.log("I'm here, right? and c is " + c);
	//lessonComplete tracks which lessons are complete, used for checkmarks in the container
	//reqLessonsComplete tracks which lessons are required (based on rc_course) and whether or not they are complete yet. 
	//movieComplete tracks which movies/topics are complete, used for checkmarks in the container
	var mylessrep = {};
	for(i=0;i<lessonTitles.length;i++){
		var shortless = lessonTitles[i][0].slice(-2);
		//console.log("shortless is " + shortless);
		mylessrep[i] = {"num":shortless, "start":0, "complete":0,"view":0,"access":0};
	
	}
	
	return {
		'eCode' : c,
		'resume' : false,
		'coursestart':0,
		'coursecomplete':0,
		'accessC':1,
		'lessonComplete' : [],
		'reqLessonsComplete' : {}, 
		'lessReport':mylessrep,
		'movieComplete' : [],
		'lprog':'0',
		'cprog':'0',
		'currentMovie' : {},
		'favorites':[],
		'mynotes':[], // stores a list of movies that have notes
		'survey':false,
		'transurvey':[true,''],
		'mymode':'light',
		'myfontsize':'100',
		'playrate':'0',
		'captions':'disabled',
		'autoadvance':'OFF',
		'autoplay':'ON',
		'countdown':'ON',
		'textonly':'OFF',
		'bookmark':'',
		'timestamp':'',
		'xtra':'none'
	};
	
}

function resetxapi(c) {
	
	const mydatenow = new Date();
	const mytimenow = mydatenow.getTime();
	var mylessrep = {};
	for(i=0;i<window.opener.lessonTitles.length;i++){
		var shortless = lessonTitles[i][0].slice(-2);
		//console.log("shortless is " + shortless);
		mylessrep[i] = {"num":shortless, "start":0, "complete":0,"view":0,"access":0};
	
	}
	return {
		'eCode' : c,
		'resume' : false,
		'coursestart':0,
		'coursecomplete':0,
		'accessC':1,
		'lessonComplete' : [],
		'reqLessonsComplete' : {}, 
		'lessReport':mylessrep,
		'movieComplete' : [],
		'lprog':'0',
		'cprog':'0',
		'currentMovie' : {},
		'favorites':[],
		'mynotes':[], // stores a list of movies that have notes
		'survey':false,
		'transurvey':[true,''],
		'mymode':'light',
		'myfontsize':'100',
		'playrate':'0',
		'captions':'disabled',
		'autoadvance':'OFF',
		'autoplay':'ON',
		'countdown':'ON',
		'textonly':'OFF',
		'bookmark':'',
		'timestamp':mytimenow,
		'xtra':'none'
	};
}
/*!
 * setLRSdata(myLRSdata:JSON)
 * 
 * sends data to LRS for progress tracking
 * unless it is a "true SCORM" course--
 * in that case, data is stored on the LMS
 *
 */
 
 function setLRSdata(){
	const dateNow = new Date();
	const timeNow = dateNow.getTime();
	eCourseX.timestamp = timeNow;
	
	myactivityIRI = window.location.href.substring(0,window.location.href.indexOf(".com/"))+ ".com/" + eCode;
	if(SCORMcourse){
		window.parent.SetDataChunk(JSON.stringify(eCourseX));
		window.parent.CommitData();
	}
	else if(typeof useXAPI != "undefined" && useXAPI == true && actor2.name != "Default User" && !testarea && actor2.name != "00000"){
		window.parent.SetDataChunk(JSON.stringify(eCourseX));
		window.parent.CommitData();
        ajaxstring=myactivityIRI+'&*'+actor2.account.name+'/'+fakeid+'('+JSON.stringify(eCourseX)+')';
		$.ajax({
			type:"POST",
			url: xAPIsetURL,
			xhrFields: { withCredentials:true},
			
			data:{
				//"actorAccount":actor2.account.homePage,
				//"actorName": actor2.account.name,
				//"activityPath":  myactivityIRI,
                "mydata":ajaxstring
				//"progressContent": JSON.stringify(eCourseX)
			},
			success: function(returncode){
				if(returncode) console.log("progress saved." );	
				else console.log("error returned from php file: progress not saved.")
			},
			error: function(){
				console.log("an error has occurred. progress was not saved.");
			}
		});
		
	}
 }


