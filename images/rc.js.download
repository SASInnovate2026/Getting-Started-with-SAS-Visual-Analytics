function showProgress(){
	var currentdata;
	myactivityIRI = document.referrer.substring(0,document.referrer.indexOf(".com/"))+ ".com/"+ eCode;
	if(window.opener.SCORMcourse){
		currentdata = window.opener.parent.GetDataChunk();
		$("#progressString").html("User ID is " + window.opener.actor2.account.name + " and progress string is " + currentdata);
		//alert("User ID is: " + window.opener.actor2.account.name + "\n" + "and progress string is " + currentdata);
	}
	else if(window.opener.actor2.name != "Default User" && window.opener.actor2.name != "00000"){
		var lmsdata = window.opener.parent.GetDataChunk();
		console.log("lmsdata is " + lmsdata);
        ajaxstring=myactivityIRI+'&*'+window.opener.actor2.account.name+'/'+fakeid;
		$.ajax({
			type: "POST",
			url:xAPIgetURL,	
			xhrFields : {
				withCredentials : true
			},
			data:{
			//	"actorAccount":window.opener.actor2.account.homePage,
				//"actorName":window.opener.actor2.account.name,
				//"activityPath": myactivityIRI
                'mydata':ajaxstring
			},
			
			crossDomain : true,
			success: function(data){
				//report back with data from LL state
				console.log("data is " + data);
				currentdata =  JSON.parse(data);
				var currentdatastring = "";
				$.each(currentdata,function(key, value){
					
					var littlevaluestring = key + ": ";
					 if(typeof(value)== 'object'){
						
						for(const[key1, value1] of Object.entries(value)){
							console.log("am i in here? " + key1 + " value is " + value1);
							if(key=="lessReport"){
								
								for(const[key2, value2] of Object.entries(value1)){
									 littlevaluestring += key2 + ": " + value2 + ",";
								}
								littlevaluestring += "<br>"
							}
							else if(key=="reqLessonsComplete") littlevaluestring += key1+": "+ value1 + ",<br>";
							else littlevaluestring += value1 + ",<br>";
						}
						
						currentdatastring += littlevaluestring + "<br>";
					}
					else currentdatastring += key + ": " + value + "<br>";
			});
				
				//alert("User ID is: " + window.opener.actor2.account.name + "\n" + "and progress string is " + data);
				$("#progressString").html("User ID is " + window.opener.actor2.account.name + " and progress string is:<br> " + currentdatastring);
			},
			error: function(){
				currentdata = "Error pulling data from LRS";
				alert("There was an error pulling data from the LRS.");
			}
		
		});
	
	} 
	else alert("Unable to detect user ID");
}

function clearProgress(){
	myactivityIRI = window.opener.location.href.substring(0,window.opener.location.href.indexOf(".com/"))+ ".com/"+ eCode;
	
		if(confirm(window.opener.xapiclear)){
		if(SCORMcourse){
			window.opener.parent.SetDataChunk("cleared");
			window.parent.CommitData();
		}
		else if(typeof useXAPI != "undefined" && useXAPI == true && useXAPI == true && window.opener.actor2.name != "Default User" && window.opener.actor2.name != "00000"){
		//need to clear all notes first
		
		//then clear data string
		eCourseX = resetxapi(eCode);
        ajaxstring=myactivityIRI+'&*'+window.opener.actor2.account.name+'/'+fakeid+'('+JSON.stringify(eCourseX)+')';
			$.ajax({
				type:"POST",
				url: xAPIsetURL,
				xhrFields: { withCredentials:true},
			
				data:{
				//	"actorAccount":window.opener.actor2.account.homePage,
				//	"actorName": window.opener.actor2.account.name,
				//	"activityPath":  myactivityIRI,
                'mydata':ajaxstring
					//"progressContent": JSON.stringify(eCourseX)
				},
				crossDomain : true,
				success: function(){
					window.opener.location.reload();
					self.close();
				},
				error: function(){
					console.log("unable to clear course data.");
				}
			});
			window.opener.parent.SetDataChunk(JSON.stringify(eCourseX));
			window.parent.CommitData();
			for(i=0;i<window.opener.eCourseX.mynotes.length;i++){
				var myshorty = window.opener.eCourseX.mynotes[i];
				var myfullname = window.opener.eCodeLC+myshorty;
				var noteLesson = myshorty.substring(0, myshorty.indexOf("_"));
				var myNotePageIRI = window.opener.location.href.substring(0,window.opener.location.href.indexOf(".com/"))+ ".com/"+ window.opener.eCode + "/" + noteLesson + "/" + myfullname;
				ajaxstring=myNotePageIRI+'&*'+window.opener.actor2.account.name+'/'+fakeid;
				$.ajax({
					type: "POST",
					url:xAPIclearURL,
					//timeout:6000,
					xhrFields : {
						withCredentials : true
					},
					data:{
						//"actorAccount":window.opener.actor2.account.homePage,
					//	"actorName":window.opener.actor2.account.name,
					//	"activityPath": myNotePageIRI
					'mydata':ajaxstring
							},
					crossDomain : true,
					success: function(){
						
					},
					error: function(){
						console.log("unable to clear course notes.");
					}
				});
			}
		}
	}
}



function statusCheck(){
	if(window.location.href.indexOf("stage")!=-1){
		var myurl = "https://learn.sas.com/vle/data/xapi/statusCheckstage.php";
	}
	else if(window.location.href.indexOf("dev")!=-1){
		var myurl = "https://learn.sas.com/vle/data/xapi/statusCheckdev.php";
	}
	else myurl = "https://learn.sas.com/vle/data/xapi/statusCheck.php";
	$.ajax({
		type: "POST",
		url:myurl,	
		xhrFields : {
			withCredentials : true
		},
		
		crossDomain : true,
		success: function(data){
			//report back with msg from ll
			alert("all seems fine");
			alert("data is " + data);
			
			if(data.substr(0,2)=="NO"){
				//console.log(data.substr(0,2));
				alert(xapiNote);
			}
			
		},
		error: function(){
			alert(xapiNote2);
			useXAPI = false;
		}
		
	});
}

//BEGIN NOTE-TAKING Code


var makeNewNote=false;

function checkNoteStatus(){
	if(window.location.href.indexOf("transcript")>0 || window.location.href.indexOf("printversion")>0) {
		var shortName = window.opener.myObjectID.substring(window.opener.eCode.length);
		if(window.opener.SCORMcourse){
			$('#takeNote2').removeClass('noteOn');
			$('#takeNote2').removeClass('noteOff');
			$('#takeNote2').addClass('noteNope');
			document.getElementById('takeNote2').disabled=true;
		}
		else{
		//if a note exists, show it
			if (window.opener.eCourseX.mynotes.indexOf(shortName)>-1){
				if(document.getElementById('noTranscript')){
					document.getElementById('notesSection').style.display="none";
					document.getElementById('noteEntry').style.display='none';
					$('#takeNote2').removeClass('noteOn');
					$('#takeNote2').removeClass('noteOff');
					$('#takeNote2').addClass('noteNope');
					document.getElementById('takeNote2').disabled=true;
				}
				else{
					document.getElementById('notesSection').style.display='block';
					if(window.opener.makeNewNote){
						document.getElementById('noteEntry').style.display='block';
						document.getElementById('userNote').focus();
						document.getElementById('userNote').scrollIntoView(true);
					}
					else {
						document.getElementById('noteEntry').style.display='none';
					}

					$('#takeNote2').removeClass('noteOff');
					$('#takeNote2').removeClass('noteNope');
					$('#takeNote2').addClass('noteOn');
					document.getElementById('takeNote2').disabled=false;
				}
			}
			else if(window.opener.makeNewNote && (window.opener.myType.indexOf("html")<0 || window.document.href.indexOf("printversion")>0)){
				document.getElementById('notesSection').style.display='none';
				document.getElementById('noteEntry').style.display='block';
				document.getElementById('userNote').focus();
				document.getElementById('userNote').scrollIntoView(true);
				$('#takeNote2').removeClass('noteOn');
				$('#takeNote2').removeClass('noteNope');
				$('#takeNote2').addClass('noteOff');
				document.getElementById('takeNote2').disabled=false;
			}
			else if(document.getElementById('noTranscript')){
				$('#takeNote2').removeClass('noteOn');
				$('#takeNote2').removeClass('noteOff');
				$('#takeNote2').addClass('noteNope');
				document.getElementById('takeNote2').disabled=true;
			}
			else{
				document.getElementById('notesSection').style.display='none';
				document.getElementById('noteEntry').style.display='none';
				$('#takeNote2').removeClass('noteOn');
				$('#takeNote2').removeClass('noteNope');
				$('#takeNote2').addClass('noteOff');
				document.getElementById('takeNote2').disabled=false;
			}
		}
	}
	else{
		console.log("checking note status");
		var shortName = myObjectID.substring(eCode.length);
		if(SCORMcourse){
			$('#takeNote2').removeClass('noteOn');
			$('#takeNote2').removeClass('noteOff');
			$('#takeNote2').addClass('noteNope');
			document.getElementById('takeNote2').disabled=true;
		}
		else{
		//if a note exists, show it
			if (eCourseX.mynotes.indexOf(shortName)>-1){
				if(document.getElementById('noTranscript')){
					document.getElementById('notesSection').style.display="none";
					document.getElementById('noteEntry').style.display='none';
					$('#takeNote2').removeClass('noteOn');
					$('#takeNote2').removeClass('noteOff');
					$('#takeNote2').addClass('noteNope');
					document.getElementById('takeNote2').disabled=true;
				}
				else{
					document.getElementById('notesSection').style.display='block';
					if(makeNewNote){
						document.getElementById('noteEntry').style.display='block';
						document.getElementById('userNote').focus();
						document.getElementById('userNote').scrollIntoView(true);
					}
					else {
						document.getElementById('noteEntry').style.display='none';
					}

					$('#takeNote2').removeClass('noteOff');
					$('#takeNote2').removeClass('noteNope');
					$('#takeNote2').addClass('noteOn');
					document.getElementById('takeNote2').disabled=false;
				}
			}
			else if(makeNewNote){
				document.getElementById('notesSection').style.display='none';
				document.getElementById('noteEntry').style.display='block';
				document.getElementById('userNote').focus();
				document.getElementById('userNote').scrollIntoView(true);
				$('#takeNote2').removeClass('noteOn');
				$('#takeNote2').removeClass('noteNope');
				$('#takeNote2').addClass('noteOff');
				document.getElementById('takeNote2').disabled=false;
			}
			else if(document.getElementById('noTranscript')){
				$('#takeNote2').removeClass('noteOn');
				$('#takeNote2').removeClass('noteOff');
				$('#takeNote2').addClass('noteNope');
				document.getElementById('takeNote2').disabled=true;
			}
			else{
				document.getElementById('notesSection').style.display='none';
				document.getElementById('noteEntry').style.display='none';
				$('#takeNote2').removeClass('noteOn');
				$('#takeNote2').removeClass('noteNope');
				$('#takeNote2').addClass('noteOff');
				document.getElementById('takeNote2').disabled=false;
			}
		}
	}
}

//makeNote function opens the popup html page with the 
//textarea opened from which to submit or edit a note

function makeNote(){
	//console.log("in make note");
	//makeNewNote=true;
	if(window.location.href.indexOf("transcript")>-1 || window.location.href.indexOf("printversion")>-1){
		if(window.opener.eCourseX.mynotes.includes(shortmov)) editNote();
		else { showNoteBox();
		}
		//window.opener.makeNewNote = true;
	}
	
	else {
		var shortmov = myObjectID.substring(eCode.length);
		if(eCourseX.textonly == "ON" || myType.indexOf("html")>-1){
			//if there is no current note for this page open the textarea
			//otherwise, trigger edit note
			if(eCourseX.mynotes.includes(shortmov)) editNote();
			else { showNoteBox();
				//document.getElementById('notesSection').style.display='block';
				//document.getElementById('myNote').style.display='none';
				//document.getElementById('noteEntry').style.display='block';
