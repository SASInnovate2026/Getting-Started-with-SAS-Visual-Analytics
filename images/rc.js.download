function getParameterByName(name) {
    name = name.replace(/[\[]/, "\\\[").replace(/[\]]/, "\\\]");
    var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
        results = regex.exec(location.search);
    return results == null ? "" : decodeURIComponent(results[1].replace(/\+/g, " "));
}

jQuery.expr[":"].Contains = jQuery.expr.createPseudo(function(arg) {
    return function( elem ) {
        return jQuery(elem).text().toUpperCase().indexOf(arg.toUpperCase()) >= 0;
    };
});

/////SEARCH FUNCTIONS/////
/*!
 * doSearch()
 *
 * search the htm file and return results.
 */
function doSearch() {
 	//$('input#searchtext2').blur();

	var searchtext = $('#searchtext2').val();
	/*if(typeof xtraselect != "undefined" && xtraselect != "none"){
		var isChecked = document.getElementById('includeSelecty');
		if(isChecked.checked) var includeSelect = 'yes';	
		else var includeSelect = 'no';}
	else*/ var includeSelect = "no";
	if(searchtext.indexOf('<') !=-1 && searchtext.indexOf('>') != -1) {
		searchtext=searchtext.replace("<", "");
		searchtext=searchtext.replace(">", "");
	}
	
	var filenamesearch = false;
	if ((searchtext == '') || (searchtext == ' ') || (searchtext == '  ')) return;
	if(searchtext == 'DEBUG!'){
		openOther('debugDLC.htm');
		return;
	}
	else if(searchtext == 'TRACKME'){
		openOther('trackDLC.htm');
		return;
	}
	else if(searchtext == 'survey'){
		openOther('survey.htm');
		return;
	}
	/*else if(searchtext == 'translation'){
		openOther('transurvey.htm');
		return;
	}*/
	else if(searchtext.indexOf(""))
	if(searchtext == 'DEBUG!') return;
	/*if(searchtext == 'movieplay'){
		openOther('movieTroubleshoot.htm');
		return;
	}*/
	var lcsearchtext = searchtext.toLowerCase();
	$.each(gMovieArray, function(i, v){
		//console.log(v[0]);
		if(searchtext == v[0]){
			//if (!onMainLevel) $(".lessonBackButton").hide();
			var nameHolder = searchtext.substring(searchtext.indexOf("_")-2,searchtext.indexOf("_"));
		//	console.log("nameHolder is " + nameHolder + " and mySCO is " + mySCO + " and this is a test " + lessonTitles[parseInt(nameHolder)]);
			if(SCORMcourse){
				if(nameHolder != mySCO)	resultsHTML = "<strong>" + v[2] + "</strong>, in lesson: " + lessonTitles[parseInt(nameHolder)][1];
				else{
					resultsHTML = '<a class="searchLinks allLinks" alt"Click to load" href="Javascript:showMovieDivCheck(\'' + searchtext + '\');">';
					resultsHTML += v[2];
					resultsHTML += "</a>";
				}
			}
			else{
				resultsHTML = '<a class="searchLinks allLinks" alt="Click to load" href="Javascript:showMovieDivCheck(\'' + searchtext + '\');">';
				resultsHTML += v[2];
				resultsHTML += "</a>";
			}
		//		$('#searchResults').html('<ul id="searchResultsUL" class="searchResultsUL" tabindex="0" aria-labelledby="searchResultsResults">' + resultsHTML + '</ul>');
			$('#searchResults').html( resultsHTML );
			
			filenamesearch = true;
			$('#searchResults').fadeIn();
			$('#searchResultsResults').focus();
			var t = setTimeout(function () {
				$('#delete').css('background-image', 'url("rc_common/close_icon.png")');
				$('#delete').attr('title', searchclear);
			}, 1000);
			return;
		}
	});
	sendXAPIstatement(xsearched,window.location.href+'/'+familycode+"/"+eCode+"/"+myLangCode+'/'+versNum  + '/'+ searchtext);
	 
	var matchCount = 0;
	var resultsCount = 0;
	var resultsHTML = '';
	var lcsearchtext = searchtext.toLowerCase();
	
	if(!filenamesearch) {
		var displayedLessonName,
		lessonName = '';
		/*if(SCORMcourse) var mysearchpath = '../search.htm?test=test .forsearch2';
		else*/ var mysearchpath = 'search.htm?test=test .forsearch2';
		$('#searchResults').load(mysearchpath , function () {
			$("#searchResults div.forsearch2").each(function (n) {
				
				$(this).hide();
				var nameHolder = $(this).attr('id');
				var classHolder = $(this).attr('class');
				if(classHolder.indexOf("select")!=-1) var origEnd = nameHolder.substring(nameHolder.lastIndexOf("_"));
				else var origEnd = "";
				var lessNum = $(this).attr('id');
				lessNum = lessNum.substring(lessNum.indexOf("_")-2,lessNum.indexOf("_"));
				if (nameHolder) {
					$(this).prepend('<br><hr>');
					//console.log("searchtext is " + searchtext);
					if ($(":Contains('" + searchtext + "')", this).length > 0) {
						if(classHolder.indexOf("select")==-1 || (classHolder.indexOf("select") != -1 && (includeSelect == "yes" || origEnd == xtraselect) )){
						
							if (lessonName == getLessonName($(this).attr('id'))) {
								displayedLessonName = '';
							} 
							else {
								lessonName = getLessonName($(this).attr('id'));
								displayedLessonName = lessonName.replace('tabindex="0"','');
								
							}
							var origMov = "no"; 
							var titlEnd = "";
							if(classHolder.indexOf("select")!=-1){						   
								for(a=0;a<selectoptions.length;a++){
									if(origEnd == selectoptions[a][0]){
										titlEnd = " " + selectoptions[a][1];
									}
								}
								var mov = nameHolder.substring(0,nameHolder.lastIndexOf("_")) + "select";
							}
							else var mov = nameHolder;
							//console.log("mov is "  + mov);
							var numuscore = mov.match(/_/gi).length;
							if(numuscore > 2 && (mov.indexOf("_l1")>-1 || mov.indexOf("_l2")>-1 || mov.indexOf("_l3")>-1 || mov.indexOf("_l4")>-1 || mov.indexOf("_l5")>-1)) {
								origMov = lessNum + '/'+ mov + '.htm';
								mov= mov.substring(0,mov.length-3);
							}
							//console.log("nameholder is " + nameHolder);
							//console.log("origmov is " + origMov);
							//console.log("mov is " + mov);
							var titl = getMovieName(mov);
							if(titl.indexOf('<img')==0)var titlDemo=titl.substring(0,titl.indexOf('>')+1);
							else var titlDemo = '';
							if(SCORMcourse)	var titlImg=titl.substring(titl.indexOf('<img src="../rc_common/'));
							else var titlImg=titl.substring(titl.indexOf('<img src="rc_common/'));
							//console.log("titlimg is " + titlImg);
							var titlText = titl.substring(titlDemo.length,titl.length-titlImg.length) + titlEnd;

							var syn = $(this).text();
							syn = syn.substring(syn.indexOf('*')+1);
							var syn2 = $(this).html();
					    	var syn4 = syn2.toLowerCase();
							if(SCORMcourse && lessNum != mySCO){
								resultsHTML += '<li class="visible searchResults" tabindex="-1">' + displayedLessonName + '<ul class="searchResultsUL movieID body" id="KB' + n + 'Parent"><li class="searchNoLinks "><strong>' + titlDemo + titlText.replace(new RegExp(searchtext, 'gi'), '<b style="background-color:gold;">' + searchtext + '</b>')  + '</strong></li>';
							}
							else{
								if(classHolder.indexOf("select") !=-1){
									resultsHTML += '<li class="visible searchResults" tabindex="-1">' + displayedLessonName + '<ul class="searchResultsUL movieID body" id="KB' + n + 'Parent"><li><button class="searchLinks allLinks" alt="Click to load" onClick="Javascript:showMovieDiv(\'' + mov + '\',\'no\',\''+origEnd+'\');">' + titlDemo + titlText.replace(new RegExp(searchtext, 'gi'), '<b style="background-color:gold;">' + searchtext + '</b>') + titlImg+ '</button></li>';
								}
								else if(origMov == "no"){
									resultsHTML += '<li class="visible searchResults" tabindex="-1">' + displayedLessonName + '<ul class="searchResultsUL movieID body" id="KB' + n + 'Parent"><li><button class="searchLinks allLinks" alt="Play Movie" onClick="Javascript:showMovieDiv(\'' + mov + '\');">' + titlDemo + titlText.replace(new RegExp(searchtext, 'gi'), '<b style="background-color:gold;">' + searchtext + '</b>') + titlImg+ '</button></li>';
								} 
								else {
									resultsHTML += '<li class="visible searchResults" tabindex="-1">' + displayedLessonName + '<ul class="searchResultsUL movieID body" id="KB' + n + 'Parent"><li><button class="searchLinks allLinks" alt="Play Movie" onClick="Javascript:showMovieDiv(\'' + mov + '\'); openSearchPractice(\''+origMov+'\');">' + titlDemo + titlText.replace(new RegExp(searchtext, 'gi'), '<b style="background-color:gold;">' + searchtext + '</b>') + titlImg+ '</button></li>';
								} 
							}
							if(getMovieType(mov)){	
								var tagopen=false;
								var searchfrom = 0;
								var syn3 = "";
								for(k=0;k<syn2.length;k++){
									if(syn2.indexOf('<',searchfrom)==k){
										tagopen=true;
										searchfrom = k;
										syn3 += syn2.charAt(k); 
									}
									else if(syn2.indexOf('>',searchfrom) == k){
										tagopen = false;
										searchfrom=k;
										syn3 += syn2.charAt(k); 
									}
									else if(syn2.indexOf(searchtext,searchfrom)== k || syn4.indexOf(lcsearchtext, searchfrom) == k){
										if(!tagopen){
											syn3 += '<b style="background-color:gold;">' + searchtext + '</b>' ;
											k=k+(searchtext.length-1)
										}
										else syn3 += syn2.charAt(k); 
										searchfrom=k+(searchtext.length);
									}
									else syn3 += syn2.charAt(k); 
								}
								resultsHTML +='<li tabindex="-1" class="searchResultsLI"><a id="syn' + n + '" href="JavaScript: return false;" class="tlink" aria-label="Expand full text of video"  onClick="expandIt(\'KB' + n + '\');$(\'#syn' + n + '\').hide();return false">(Click to expand)<br>' + syn.substring(0, 80) + '...</a><br/><a id="KB' + n + 'Child" class="child tlink tlink2" tabindex="-1" href="JavaScript: return false;" onClick="expandIt(\'KB' + n + '\');$(\'#syn' + n + '\').show();return false">(Click to collapse)';
								resultsHTML += syn3;
								resultsHTML += '</a></li>';
							}
							resultsHTML+='</ul></li>';
							$(this).show();
							matchCount++;
						}
					}
					resultsCount++;
				}
			});
			
			$('#searchResults').html('<ul id="searchResultsUL" class="searchResultsUL" tabindex="0" aria-labelledby="searchResultsResults">' + resultsHTML + '</ul>');
			$('#searchResults math b').contents().unwrap();
		
			if (matchCount == 0) {
				$('#searchResults').html('<h2 id="searchResultsResults" tabindex="0">' + searchno + '</h2>');
			} else {  //full cours search with results
				$('#searchResults').prepend('<h2  id="searchResultsResults" tabindex="0">' + matchCount + searchyesfull + '</h2><button id="delete" title="Clear search results"></button><br><hr>')
			}
			if (typeof xtraselect !="undefined" && xtraselect !="none")  $('#searchResults').prepend("<br><br>");
		//	$('#delete').css('background-image', 'url("rc_common/loading.gif")');
			$('#searchResults').fadeIn();
			$('#searchResultsResults').focus();
			var t = setTimeout(function () {
					$('#delete').css('background-image', 'url("rc_common/close_icon.png")');
				}, 1000);
		});

	return;
	}
	$('#searchResultsResults').focus();
}

$(document).on("click","#delete", function (e) {
	closeSearch();
});

$(document).on("touchstart","#delete", function (e) {
	e.preventDefault();
	closeSearch();
});


function closeSearch() {
	$("#searchtext2").val("");
//	$('#searchResults').fadeOut();
	$('#searchResults').html('');
}

/*!
 * getMovieName(mov:String)
 *
 *
 */
function getMovieName(mov) {
	//console.log("in getMoviename and mov is " + mov);
	var match = false;
	var plevel = "none";
	var numuscore = mov.match(/_/gi).length;
	if(numuscore > 2 && (mov.indexOf("_l1")>-1 || mov.indexOf("_l2")>-1 || mov.indexOf("_l3")>-1 || mov.indexOf("_l4")>-1 || mov.indexOf("_l5")>-1)) {
		plevel = mov.substr(mov.length-1, 1);
		mov = mov.substr(0,mov.length-3);
		//console.log("plevel is " + plevel + " and mov is " + mov);
	}
	
	$.each(gMovieArray, function (i, v) {
		if (v[0] == mov){
			if(v[1]=="vid")	{
				match = v[2] + '<img src="rc_common/showmovie.png" alt="Load Video" border="0">';
			}
			else {
				if(plevel != "none"){
					match = v[2] + '<img src="rc_common/showpage.png" alt="Load Page" border="0"> Link '  + plevel; 
				}
				else {
					match = v[2] + '<img src="rc_common/showpage.png" alt="Load Page" border="0">'; 
				}
			}
		}
	});
	//console.log("in getMovieName and match is " + match);
	return match;
}


function getMovieType(mov) {
	var movieType = false;
	$.each(gMovieArray, function (i, v) {
		if (v[0] == mov){
				if(v[1]=="vid")	movieType=true;	
		}
	});
	return movieType;
}

/*!
 * getMovieName(mov:String)
 *
 * "quick" way to get the movie name.
 *
 */
function getLessonName(mov) {
	var match = false;
	var les = mov.split('_');
	$.each(lessonTitles, function (i, v) {
		if (v[0] == les[0])
			match = '<h3 class="lessTitle" tabindex="0">' + v[1] + '</h3>';
	});
	return match;
}

function expandIt(el) { 
    whichEl = document.getElementById(el + "Child"); 
    if (whichEl.style.display != "block") {
        whichEl.style.display = "block";
    }
    else {
        whichEl.style.display = "none";
    }  
	
}

