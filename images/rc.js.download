    /*!
     * createLessonTOC(lesson:Array)
     *
     */
function createLessonTOC(lesson) { 
	//console.log("currentSelect is " + currentSelect);
	var selectnum=-1;
	if(typeof xtraselect != "undefined" && xtraselect != "none"){
		for (i=0;i<selectoptions.length;i++){
			if(selectoptions[i][0] == xtraselect){
				currentSelect = selectoptions[i][1];
				selectnum = i;
				break;
			} 
		}
	}
	
    var topicCounter = 0;
    var myLesson = lesson.slice(-2); // 00, 01 etc
    var myHTML = "";
    /*! create array of all sections in the current lesson */
    $.each(lessonTitles, function (i, v) {
        if (v[0] == lesson) { 
            myList = window["movieArray" + myLesson]; // movies277
            autoTOC = myList;
            mySectionArray = window["sectionArray" + myLesson];
            $.each(mySectionArray, function (i, v) {
                mySectionM = v[0]; // m277_0 
                mySectionTitle = v[1]; // Introduction
                var _html = "";
                for (k = 0; k <= myList.length - 1; k++) {
                    if (myList[k][2].indexOf('>') > -1){ 
                        var start = (myList[k][2].lastIndexOf('>'))+1;
                        var imgStripper = myList[k][2].substr(start); 
                    }
                    else {
						var imgStripper = myList[k][2];
					}
                    if (mySectionM == myList[k][0].substring(0, myList[k][0].lastIndexOf("_"))) { // epg1v201_0
                        /*! add movietimes */
                        var movieTime = '<span class="movieTime2">' + ((myList[k][3]) ? ' ' + myList[k][3] : '') + '</span> ';
                        /*! add spoken movietimes */
                        var ariaMovieTime ='';
                        if (myList[k][3] && myList[k][0].indexOf("select")==-1)	{
							var ariaTime = myList[k][3].split(":"); 
							if (ariaTime[0] == 1) ariaMovieTime =  ' ' + ariaTime[0]+' minute and ' +ariaTime[1]+' seconds';
							else if (ariaTime[0] == 0) ariaMovieTime = ' ' + ariaTime[1]+' seconds';
							else ariaMovieTime = ' ' + ariaTime[0]+' minutes and ' +ariaTime[1]+' seconds';
						} 
						else if (myList[k][3] && myList[k][0].indexOf("select")>-1)	{
							
							movieTime = '<span class="movieTime2">' + myList[k][3][selectnum] + '</span>';
							var ariaTime = myList[k][3][selectnum].split(":"); 
							if (ariaTime[0] == 1) ariaMovieTime =  ' ' + ariaTime[0]+' minute and ' +ariaTime[1]+' seconds';
							else if (ariaTime[0] == 0) ariaMovieTime = ' ' + ariaTime[1]+' seconds';
							else ariaMovieTime = ' ' + ariaTime[0]+' minutes and ' +ariaTime[1]+' seconds';
						}  
                            /*! create the movielinks */
							if (myList[k][0] && myList[k][0].indexOf("select")>-1)	_html += '<div class="toc_item" id="mcheck_' + myList[k][0] +'"><div class="toc_link"><button class="allLinks movieLinks' + ((myList.length == 1) ? ' indentTopLevel' : '') + '" ' + 'onclick="javascript:showMovieDivCheck(\'' + myList[k][0] + '\');" id="mcheck_' + myList[k][0] + '" class="' + 'lessonButton' + ((myList.length != 1) ? ' indentChildLevel' : '') + '" aria-label="' + imgStripper + ariaMovieTime + '" lang="en-US">' + myList[k][2] + ' '+ currentSelect +' <img src="rc_common/multi-topic-toc.svg" width="14" height="14" alt="Mulitple versions" border="0">  '+  movieTime + '</button></div><div id="fave_' + myList[k][0] +'" class="faveDiv"><button class="faveBtn starOff" onClick="javascript: setFavorite(\'' + myList[k][0] + '\');" aria-label="Add to favorites" title="Add to favorites"></button></div></div>';   
							else _html += '<div class="toc_item" id="mcheck_' + myList[k][0] +'"><div class="toc_link"><button class="allLinks movieLinks' + ((myList.length == 1) ? ' indentTopLevel' : '') + '" ' + 'onclick="javascript:showMovieDivCheck(\'' + myList[k][0] + '\');" id="mcheck_' + myList[k][0] + '" class="' + 'lessonButton' + ((myList.length != 1) ? ' indentChildLevel' : '') + '" aria-label="' + imgStripper + ariaMovieTime + '" lang="en-US">' + myList[k][2] + movieTime + '</button></div><div id="fave_' + myList[k][0] +'" class="faveDiv"><button class="faveBtn starOff" onClick="javascript: setFavorite(\'' + myList[k][0] + '\');" aria-label="Add to favorites" title="Add to favorites"></button></div></div>';  
							myMovieTitle = myList[k][2];
							
                        //	eCourse.total++;
                            topicCounter++;
                    }
                }
			   // note: not sure why we are adding myList.length as a class in the span tag
               //if there is one section in a lesson and the sectionTitle is blank then no title
				if ((mySectionArray.length == 1) && ((mySectionTitle == "") || (mySectionTitle == " "))) {
					_html = '<span class="sectionTitle" id="blankTitle">' + _html + '</span>';
				}
				//if there is one movie in a  section and the section title is not the same as the movie title, write the section title
				else if ((topicCounter == 1) && (mySectionTitle != myMovieTitle)) {
					_html = '<span class="sectionTitle" id="' + mySectionTitle + '"><h3>' + mySectionTitle + '</h3>' + _html + '</span>';
				}	
				//if there is one movie in a section and the section title is the same as the movie title or blank, no title
				else if ((topicCounter == 1) && ((mySectionTitle == myMovieTitle) || (mySectionTitle == "") || (mySectionTitle == " "))) {
					_html = '<span class="sectionTitle" id="' + mySectionTitle + '">' + _html + '</span>';
				}
				//if there's more than one movie in a section and the section title is blank, no title
				else if ((topicCounter != 1) && ((mySectionTitle == "") || (mySectionTitle == " "))) {
					_html = '<span class="sectionTitle" id="blankTitle">' + _html + '</span>';
				}
				//write the title
				else if (topicCounter != 1) {
					_html = '<span class="sectionTitle" id="' + mySectionTitle + '"><h3>' + mySectionTitle + '</h3>' + _html + '</span>';
				}
				//never gets to this
				else {
					_html = '<span class="sectionTitle">' + _html + '</span>';
				}
                myHTML += _html
                topicCounter = 0;
            });
        }
    });

    return myHTML;
}
    
